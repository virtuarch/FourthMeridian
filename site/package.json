{
  "name": "fourth-meridian-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "fourthmeridian.com \u2014 the public, zero-authority website. Static export; no secrets, no API, no session.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "build:clean-env": "node scripts/clean-env-build.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "node --test \"tests/*.test.mts\"",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run build:clean-env"
  },
  "dependencies": {
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "typescript": "5.9.3"
  }
}
