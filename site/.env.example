# fourthmeridian.com public site — the COMPLETE list of variables it reads.
# Both are PUBLIC origins, not secrets. There is nothing else to set.
#
# Development: leave both unset; `next dev` uses http://localhost:3000 (the
# financial app's dev server) and http://localhost:3001 (this site).
# Production build: both REQUIRED and must be public https origins.
#
# Production:  NEXT_PUBLIC_SITE_ORIGIN=https://fourthmeridian.com
#              NEXT_PUBLIC_APP_ORIGIN=https://app.fourthmeridian.com
# Preview:     NEXT_PUBLIC_SITE_ORIGIN=https://preview.fourthmeridian.com
#              NEXT_PUBLIC_APP_ORIGIN=https://preview-app.fourthmeridian.com
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_APP_ORIGIN=
