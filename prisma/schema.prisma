generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // In production/staging (Supabase), set DATABASE_URL to the Transaction Pooler URL
  // (port 6543, ?pgbouncer=true) for Vercel serverless compatibility.
  // Set DIRECT_URL to the direct connection URL (port 5432) for migrations.
  // In local dev both can point to the same Docker Postgres URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum AccountType {
  checking
  savings
  investment
  crypto
  debt
  other
}

enum TransactionCategory {
  Income
  Transfer
  Groceries
  Dining
  Shopping
  Travel
  Subscriptions
  Utilities
  Interest
  Payment
  Other
  // Investment transactions
  Buy
  Sell
  Dividend
  Split
  Fee
  // MI1 M1 — expanded spend vocabulary (persisted-tier plan §2.3 / readiness
  // investigation §4.5). Six committed spend categories that rescue PFC spend
  // primaries currently collapsing to `Other`. Each has a committed producer in
  // MI M2's resolution stack. Enum additions are irreversible — admitted here
  // in their own migration file, additively; nothing writes them until M2.
  Medical
  Entertainment
  Transport
  PersonalCare
  Services
  Education
}

enum RiskLevel {
  low
  medium
  high
}

enum PlaidItemStatus {
  ACTIVE // syncing normally
  NEEDS_REAUTH // user must re-authenticate via Plaid Link
  ERROR // unrecoverable error — see errorCode
  REVOKED // all accounts removed; itemRemove() was called
}

/// Per-Item Plaid Investments product consent state, derived from the `item`
/// object returned by accountsGet (consented_products / available_products /
/// billed_products) and, for pre-DTM Items, from probing
/// investmentsHoldingsGet once. Gates the holdings step of refresh so we
/// never repeatedly call an endpoint Plaid will reject with
/// ADDITIONAL_CONSENT_REQUIRED. Re-derived on every refresh, so it self-heals
/// after the user grants consent via Link update mode. See
/// docs/investigations/PLAID_INVESTMENTS_CONSENT_INVESTIGATION.md.
enum PlaidInvestmentsConsent {
  ENABLED // user consented to investments (or legacy probe succeeded)
  CONSENT_REQUIRED // supported, but user must grant consent via Link update mode
  UNSUPPORTED // Plaid Investments not available for this Item
}

/// D2 (Phase 2, Step 1A): generalizes PlaidItemStatus across all connection
/// types. Mirrors PlaidItemStatus exactly. PlaidItem keeps its own enum
/// unchanged — this is additive, not a replacement. Live since the v1.5 wallet
/// wiring (lib/accounts/wallet-connection.ts) and the PLAID Connection
/// dual-write (lib/plaid/exchangeToken.ts) — Connection.status is the
/// authoritative sync-health record for non-PLAID providers (WALLET included).
enum ConnectionStatus {
  ACTIVE // syncing normally / valid credential
  NEEDS_REAUTH // user must re-authenticate
  ERROR // unrecoverable error — see errorCode
  REVOKED // credential revoked / connection removed
}

/// D2 (Phase 2, Step 1A): identifies which kind of provider a Connection
/// represents. Extensible — new values can be appended later without a
/// breaking migration. Live: PLAID (dual-written alongside PlaidItem in
/// lib/plaid/exchangeToken.ts) and WALLET (created/synced by
/// lib/accounts/wallet-connection.ts + lib/crypto/btc-sync.ts); the remaining
/// values are reserved for future providers.
enum ProviderType {
  PLAID
  MANUAL
  WALLET
  CSV
  EXCHANGE
  BROKERAGE
}

/// Renamed from Workspace -> Space (Fourth Meridian Phase 1 naming migration).
/// DB1 (2026-07): physical enum type renamed WorkspaceType -> SpaceType, so the
/// DB type name now matches and no @@map is needed.
enum SpaceType {
  PERSONAL
  SHARED
}

/// Semantic category for a Space — drives default UI labels, section presets, and AI context.
/// Renamed from WorkspaceCategory -> SpaceCategory (DB1: physical enum type renamed to match).
enum SpaceCategory {
  PERSONAL
  HOUSEHOLD
  FAMILY
  BUSINESS
  PROPERTY
  VEHICLE
  TRIP
  INVESTMENT
  EQUIPMENT
  GOAL // legacy — kept for backward compat
  RETIREMENT
  DEBT_PAYOFF
  EMERGENCY_FUND
  CUSTOM
  OTHER
}

/// Tabs available on the Space planning dashboard.
/// Each SpaceDashboardSection belongs to one tab.
/// Renamed from WorkspaceDashboardTab -> SpaceDashboardTab (DB1: physical enum type renamed to match).
enum SpaceDashboardTab {
  OVERVIEW
  GOALS
  ACCOUNTS
  DEBT
  INVESTMENTS
  RETIREMENT
  ACTIVITY
  SETTINGS
}

/// Renamed from WorkspaceMemberRole -> SpaceMemberRole (DB1: physical enum type renamed to match).
enum SpaceMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Soft-membership state. REMOVED = kicked by OWNER/ADMIN. LEFT = self-removed.
/// Row is never deleted so audit history is preserved.
/// Renamed from WorkspaceMemberStatus -> SpaceMemberStatus (DB1: physical enum type renamed to match).
enum SpaceMemberStatus {
  ACTIVE
  REMOVED
  LEFT
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Controls how a FinancialAccount is visible to a Space it has been shared into.
/// BALANCE_ONLY added for privacy-sensitive sharing (e.g. a partner sees total but not institution).
/// FULL replaces the old SHARED value; SHARED is a dormant legacy enum value
/// (maps to FULL) whose removal is tracked separately from the Account retirement
/// — a Postgres enum-value drop is its own migration.
enum VisibilityLevel {
  PRIVATE // only the owning Space can see this account
  BALANCE_ONLY // other Space sees the balance total, no institution or transactions
  SUMMARY_ONLY // qualitative summary, no raw numbers
  SHARED // legacy — maps to FULL; dormant, retirement tracked separately
  FULL // fully visible to all Space members (new canonical value)
}

/// Whether a SpaceAccountLink is currently active or has been revoked.
/// (Originally introduced for WorkspaceAccountShare, retired v2.5-A Phase 4c.)
enum ShareStatus {
  ACTIVE
  REVOKED
}

/// D3 (Phase 2): which role a SpaceAccountLink row plays for its account.
/// Exactly one HOME row exists per financialAccountId (the account's
/// primary/owning Space, replacing ownerSpaceId/ownerUserId); any number of
/// SHARED rows may exist (replacing WorkspaceAccountShare). Enforced at the DB
/// level (KD-5) by the partial unique index
/// `SpaceAccountLink_one_home_per_account` — UNIQUE (financialAccountId) WHERE
/// kind = 'HOME' — added via a raw-SQL migration because Prisma has no
/// partial-unique-index syntax (see
/// prisma/migrations/20260702170000_kd5_home_partial_unique_index).
/// computeLinkKind in lib/accounts/space-account-link.ts remains the source of
/// HOME/SHARED assignment; the index only backstops it against concurrent
/// HOME races.
enum SpaceAccountLinkKind {
  HOME
  SHARED
}

/// Lifecycle of a suspected duplicate pair surfaced by the system.
/// CONFIRMED_DUPLICATE is written automatically today by the merge path in
/// lib/accounts/reconcile.ts (mergeArchivedDuplicateIntoCanonical) — there is
/// no gate that blocks a merge pending review. PENDING / NOT_DUPLICATE /
/// IGNORED are not written by any code path today; they're kept, unused, in
/// case a future manual-review feature is layered on top of this ledger.
enum DuplicateStatus {
  PENDING // flagged, awaiting user review
  CONFIRMED_DUPLICATE // user confirmed these are the same real-world account
  NOT_DUPLICATE // user confirmed these are different accounts
  IGNORED // user dismissed without deciding
}

/// How an automatic merge in lib/accounts/reconcile.ts was detected. Always
/// populated on rows written by that path — there is no ambiguous/unset case
/// today.
enum DuplicateDetectionSource {
  PROVIDER_IDENTITY_MATCH // exact plaidAccountId or walletAddress match
  FINGERPRINT_MATCH // loose institution + mask + type + name match
  SIBLING_CONSOLIDATION // multiple matching rows reduced to one canonical row, independent of the top-level trigger
}

/// Whether a FinancialAccount is owned by an individual user or by a Space entity.
/// SPACE was renamed from WORKSPACE in the Fourth Meridian Phase 1 naming migration —
/// this is a real `ALTER TYPE ... RENAME VALUE` migration (see
/// prisma/migrations/*_rename_account_owner_type_workspace_to_space/), not a @map,
/// because the existing label is genuinely renamed end-to-end. The rename is
/// metadata-only in Postgres: existing rows keep referencing the same enum OID,
/// so no row data is rewritten and no UPDATE statement is needed.
enum AccountOwnerType {
  USER // personal account owned by a single user
  SPACE // Space-level account (e.g. a joint or business account)
}

enum UserRole {
  USER // normal authenticated user
  SYSTEM_ADMIN // platform administration — not for daily use; requires TOTP (M3)
}

/// PO1.0 — a platform-facing area of Fourth Meridian itself, each backed by
/// exactly one system-singleton Space (Space.platformArea). Extensible:
/// adding an area = one enum value + one PLATFORM_AREAS metadata entry +
/// re-running the idempotent seed. NOT user-facing categorization — that is
/// SpaceCategory; do not conflate (see PO1 capabilities investigation §1.5).
enum PlatformArea {
  PLATFORM_OPS
  SECURITY_OPS
  GROWTH_REVENUE
  CUSTOMER_SUCCESS
}

/// Ranked access level within one PlatformArea. CONTROL ≥ WRITE ≥ READ
/// (LEVEL_RANK in lib/platform/policy.ts) — never compared for equality,
/// mirroring how SpaceMemberRole is consumed via ROLE_RANK/ROLE_ORDER.
///
/// CONTROL (OPS-2D-2) is reserved for mutations that change the platform's own
/// operating behaviour — admission, scheduling intent, provider enablement,
/// recovery policy — as opposed to WRITE, which performs ordinary operational
/// work WITHIN the current behaviour. It exists canonically but is deliberately
/// NOT yet issuable and NOT yet required by any route: see ISSUABLE_LEVELS in
/// lib/platform/policy.ts and the classification table in
/// lib/platform/capability-classification.ts. No row carries it.
enum PlatformAccessLevel {
  READ
  WRITE
  CONTROL
}

/// Grant lifecycle. Rows are never deleted — revocation is a status flip with
/// provenance, mirroring SpaceMember ("rows are never deleted").
enum PlatformGrantStatus {
  ACTIVE
  REVOKED
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  SELF_EMPLOYED
  STUDENT
  RETIRED
}

enum UseCase {
  PERSONAL_TRACKING // personal budget + net worth tracking
  BUSINESS_VENTURES // business / LLC financial oversight
  INVESTING // portfolio + market focus
  DEBT_MANAGEMENT // debt payoff planning
  OTHER
}

/// Category of a financial goal — drives default labels and AI context.
enum GoalCategory {
  EMERGENCY_FUND
  DEBT_PAYOFF
  HOME_PURCHASE
  VEHICLE_PURCHASE
  TRIP
  BUSINESS
  INVESTMENT
  EQUIPMENT
  EDUCATION
  GENERAL
}

/// Lifecycle state of a SpaceGoal.
enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// Governs which fields and tracking mode apply to a SpaceGoal.
enum GoalType {
  FINANCIAL // Save $X by a target date
  HABIT // Behavioral goal tracked by streak / check-ins
  SPENDING_LIMIT // Keep a spending category under $X / month
  DEBT_REDUCTION // Pay down a specific debt account by $X or X%
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ficoScore removed — now lives in CreditScore for time-series tracking.
// Profile fields (DOB, employment, useCase) feed the AI advice engine.
// dateOfBirthEncrypted is AES-256-GCM (same key as Plaid tokens).
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  username                String?           @unique
  name                    String?
  firstName               String?
  lastName                String?
  dateOfBirthEncrypted    String? // AES-256-GCM encrypted ISO date string
  employmentStatus        EmploymentStatus?
  useCase                 UseCase?
  passwordHash            String? // bcrypt hash, cost 12
  totpSecret              String? // TOTP seed, stored encrypted (used in M3)
  totpEnabled             Boolean           @default(false)
  role                    UserRole          @default(USER)
  preferredSpaceId        String? // soft ref — Space the user lands on after login
  passwordResetToken      String?           @unique
  passwordResetExpiry     DateTime?
  forcePasswordReset      Boolean           @default(false) // set true by admin; user must change on next login
  // OPS-1 S2b — email verification seam. `emailVerifiedAt` is the verification
  // state (null = unverified; timestamp = when verified). Token columns mirror
  // the password-reset pattern (hashed at rest, single outstanding token, 1h
  // TTL). STORED-BUT-NOT-CONSUMED in S2b: new signups receive a verification
  // email and these are written, but NO route/gate reads them yet. Existing
  // users are backfilled to verified by the S2b migration so they are never
  // treated as unverified.
  emailVerifiedAt         DateTime?
  emailVerificationToken  String?           @unique
  emailVerificationExpiry DateTime?
  // PO-5A — Terms/Privacy consent captured at registration. `acceptedTermsAt` is
  // the timestamp of affirmative agreement; `acceptedTermsVersion` records which
  // policy version was accepted. Nullable/additive — existing rows stay null
  // (never backfilled to a consent the user did not give).
  acceptedTermsAt         DateTime?
  acceptedTermsVersion    String?
  // OPS-2 S3a — authenticated email-change seam. `pendingEmail` holds the
  // requested new address (not yet active); the token columns mirror the
  // verification/reset pattern (hashed at rest, single outstanding token, 1h
  // TTL). NOT swapped until the S3b confirm consumer lands. `pendingEmail` is
  // intentionally NOT @unique — final uniqueness is enforced at swap against
  // the live `email @unique`.
  pendingEmail            String?
  emailChangeToken        String?           @unique
  emailChangeExpiry       DateTime?
  // OPS-2 S4 — account deactivation. Null = active; timestamp = when the user
  // deactivated. Deactivated ≠ deleted: all data, Space memberships, and
  // PlaidItems stay intact — only login is gated (lib/auth.ts +
  // /api/auth/pre-login) and the bank-sync cron skips the user's items
  // (jobs/sync-banks.ts). Cleared by the explicit reactivation leg of login
  // (`reactivate` credential flag; requires full auth incl. TOTP).
  deactivatedAt           DateTime?
  // OPS-2 S7a — account-deletion foundations. Null = not scheduled for
  // deletion. deletionRequestedAt records WHEN the user asked to delete;
  // deletionScheduledAt is when the purge becomes due (requestedAt + grace).
  // Pending-deletion reuses deactivatedAt as the login/sync lockout (set
  // alongside these in S7b); deletionScheduledAt is the discriminator the
  // login gate reads to show "pending deletion — cancel?" instead of the
  // deactivation message. Cleared together by the login cancelDeletion leg
  // (lib/auth.ts, mirrors the S4 reactivation leg). No purge/cron/route in
  // S7a — those are S7b/S7c. See OPS2_S7_ACCOUNT_DELETION_INVESTIGATION.md.
  deletionRequestedAt     DateTime?
  deletionScheduledAt     DateTime?
  lastBriefViewedAt       DateTime? // set when user views the Daily Brief page
  // OPS-3 S3 — the user's IANA timezone (e.g. "America/New_York"). A general
  // preference (Settings → Preferences), not notification-specific: consumed
  // by future digests (S6), quiet hours (OPS-4), and Brief greetings. Null =
  // never set; consumers fall back to UTC.
  timezone                String?
  // MC1 Phase 3 (D-1/D-2) — the user's DEFAULT reporting currency. A default
  // ONLY: it seeds reportingCurrency for Spaces this user creates (copy-once
  // at POST /api/spaces) and denominates nothing by itself. NO retroactive
  // inheritance — editing this never re-denominates existing Spaces; the
  // Space's own value is the only one consulted for Space-scoped totals.
  reportingCurrency       String            @default("USD")
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  spaces                SpaceMember[]
  sentInvites           SpaceInvite[]          @relation("SentInvites")
  receivedInvites       SpaceInvite[]          @relation("ReceivedInvites")
  plaidItems            PlaidItem[]
  connections           Connection[] // D2 — PLAID rows created/updated by lib/plaid/exchangeToken.ts; read by app/api/plaid/link-token
  importBatches         ImportBatch[] // D2 Step 4D — populated by the import pipeline (app/api/accounts/[id]/import)
  importMappingProfiles ImportMappingProfile[] // D2 (Phase 2, Step 4D-5b) — additive; display-only creator ref, not an authorization boundary
  creditScores          CreditScore[]
  auditLogs             AuditLog[]

  // Security
  recoveryCodes RecoveryCode[]
  sessions      UserSession[]

  // New financial account relations
  financialAccounts        FinancialAccount[]  @relation("UserOwnedFinancialAccounts")
  accountConnections       AccountConnection[] @relation("UserConnectedAccounts")
  createdFinancialAccounts FinancialAccount[]  @relation("FinancialAccountCreator") // D11 — accounts this user created/connected, independent of ownerType

  // Member revocation (who revoked whom)
  revokedMembers SpaceMember[] @relation("RevokedByUser")

  // Goal creation
  createdGoals SpaceGoal[] @relation("GoalCreator")

  // SpaceAccountLink (D3) — the sole account-link path since WorkspaceAccountShare
  // was retired (v2.5-A Phase 4c). Tracks who added/revoked links.
  addedSpaceAccountLinks   SpaceAccountLink[] @relation("SpaceAccountLinkAdder")
  revokedSpaceAccountLinks SpaceAccountLink[] @relation("SpaceAccountLinkRevoker")

  // DuplicateAccountCandidate — tracks who resolved the review
  resolvedDuplicates DuplicateAccountCandidate[] @relation("DuplicateResolver")

  // Notifications (OPS-3 S1) — the user's inbox; Cascade (unlike AuditLog's
  // SetNull) because notifications are per-user awareness, not forensics.
  notifications           Notification[]
  // Notification preference overrides (OPS-3 S3) — rows exist ONLY when the
  // user deviates from the registry default (default-by-absence).
  notificationPreferences NotificationPreference[]

  // Platform access (PO1.0) — grants HELD by this user (the platform-access
  // source of truth), plus provenance back-relations for grants this user
  // issued / revoked as a SYSTEM_ADMIN.
  platformGrants        PlatformGrant[] @relation("PlatformGrantsHeld")
  platformGrantsIssued  PlatformGrant[] @relation("PlatformGrantsIssued")
  platformGrantsRevoked PlatformGrant[] @relation("PlatformGrantsRevoked")

  // Wealth-timeline amendment system (Phase 2) — amendments this user requested.
  requestedSnapshotAmendments SnapshotAmendment[] @relation("SnapshotAmendmentRequester")
}

// ─────────────────────────────────────────────────────────────────────────────
// Space (renamed from Workspace — Fourth Meridian Phase 1 naming migration)
// Container for all financial data. Every user auto-receives one PERSONAL
// Space on registration. Additional SHARED Spaces can be created or
// joined (Hogan Family, Atlanta Duplex LLC, etc.)
// category provides semantic context for the Space (e.g. HOUSEHOLD, BUSINESS).
// DB1 (2026-07): the physical table was renamed Workspace -> Space, so the
// @@map is gone and the DB table name now matches the model.
// ─────────────────────────────────────────────────────────────────────────────

model Space {
  id                String        @id @default(cuid())
  name              String
  description       String?
  type              SpaceType     @default(PERSONAL)
  category          SpaceCategory @default(PERSONAL)
  // PO1.0 — non-null marks this row as the system-singleton platform Space
  // for one PlatformArea: bootstrap-seeded (lib/platform/seed.ts), never
  // client-creatable (POST /api/spaces does not read this field), un-deletable
  // in practice (no SpaceMember rows ever exist, so every membership-gated
  // lifecycle route already denies; tripwired in lib/platform-surface.test.ts).
  // @unique doubles as the one-Space-per-area invariant (NULLs are distinct).
  platformArea      PlatformArea? @unique
  isPublic          Boolean       @default(false) // SHARED Spaces can be listed publicly
  // MC1 Phase 3 (D-1/D-2/D-4) — the AUTHORITATIVE reporting currency for every
  // aggregate, snapshot stamp, chart, and AI total computed within this Space.
  // Seeded copy-once from the creator's User.reportingCurrency at creation;
  // thereafter owned by the Space alone (no live inheritance). Changing it is
  // FORWARD-ONLY: live aggregates re-denominate on the next read, snapshots
  // stamp the new currency from the next write, and existing snapshot rows
  // keep their stamps — history is never rewritten. Allowed values: FX_BASE +
  // SUPPORTED_QUOTES (lib/fx/config.ts), enforced at the API boundary.
  // Nothing reads this until the Phase 3 flip slices (3–6).
  reportingCurrency String        @default("USD")

  // ── Lifecycle (mirrors SpaceGoal's archive/trash pattern) ─────────────────
  // archivedAt: hidden from normal nav, fully intact, restorable any time.
  // deletedAt:  moved to trash, hidden from normal nav, restorable until
  //             permanently deleted. Trashing always clears archivedAt so a
  //             Space is never in both states at once. PERSONAL
  //             Spaces cannot be archived, trashed, or permanently
  //             deleted (enforced in the API layer, not the schema).
  archivedAt DateTime?
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       SpaceMember[]
  invites       SpaceInvite[]
  snapshots     SpaceSnapshot[]
  aiAgent       AiAgent?
  adviceHistory AiAdvice[]
  auditLogs     AuditLog[]

  // New financial account relations
  // SpaceAccountLink (D3) — the sole account-link path since WorkspaceAccountShare
  // was retired (v2.5-A Phase 4c).
  accountLinks           SpaceAccountLink[]
  ownedFinancialAccounts FinancialAccount[]      @relation("SpaceOwnedFinancialAccounts")
  goals                  SpaceGoal[]
  dashboardSections      SpaceDashboardSection[]
  // ImportMappingProfile (D2, Phase 2, Step 4D-5b) — additive; Space-scoped
  // saved column mappings, auto-used by the import pipeline when they match
  // an upload's headers. See
  // docs/initiatives/d2/implementation/D2_STEP4D5B_IMPLEMENTATION_PLAN.md.
  importMappingProfiles  ImportMappingProfile[]

  // Notifications (OPS-3 S1) — optional Space context; SetNull on Space delete.
  notifications Notification[]

  // Wealth-timeline amendment system (Phase 2) — deliberate, consent-gated
  // rebuilds of this Space's already-written historical SpaceSnapshot rows.
  snapshotAmendments SnapshotAmendment[]

  @@index([type])
  @@index([isPublic])
  @@index([archivedAt])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SpaceMember (renamed from WorkspaceMember)
// Join table linking users to Spaces with roles.
// status: ACTIVE (normal), REMOVED (kicked), LEFT (self-removed).
// Rows are never deleted — status update preserves audit history.
// When status becomes REMOVED or LEFT, all SpaceAccountLink records
// contributed by that user are revoked.
// ─────────────────────────────────────────────────────────────────────────────

model SpaceMember {
  id       String            @id @default(cuid())
  spaceId  String
  space    Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     SpaceMemberRole   @default(MEMBER)
  status   SpaceMemberStatus @default(ACTIVE)
  joinedAt DateTime          @default(now())

  // Populated when status transitions to REMOVED or LEFT
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("RevokedByUser", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([spaceId, userId])
  @@index([spaceId])
  @@index([userId])
  @@index([spaceId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformGrant (PO1.0)
// THE platform-access source of truth: user × area × level.
// Orthogonal to SpaceMember on purpose: holding a grant makes the area's
// platform Space visible (access-derived listing union) and gates its data
// routes via requirePlatformAccess — it never creates a SpaceMember row and
// never confers any customer-Space authority (and vice versa).
// ─────────────────────────────────────────────────────────────────────────────

model PlatformGrant {
  id     String              @id @default(cuid())
  userId String
  user   User                @relation("PlatformGrantsHeld", fields: [userId], references: [id], onDelete: Cascade)
  area   PlatformArea
  level  PlatformAccessLevel
  status PlatformGrantStatus @default(ACTIVE)

  grantedById String?
  grantedBy   User?    @relation("PlatformGrantsIssued", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedAt   DateTime @default(now())

  // Populated when status transitions to REVOKED (mirrors SpaceMember.revokedBy*)
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("PlatformGrantsRevoked", fields: [revokedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@unique([userId, area])
  @@index([userId, status])
  @@index([area, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// SpaceInvite (renamed from WorkspaceInvite)
// Grant-only access. Only existing members with OWNER or ADMIN role can invite.
// Users cannot request access — they can only accept or decline an invite.
// ─────────────────────────────────────────────────────────────────────────────

model SpaceInvite {
  id            String          @id @default(cuid())
  spaceId       String
  space         Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  invitedById   String
  invitedBy     User            @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUserId String
  invitedUser   User            @relation("ReceivedInvites", fields: [invitedUserId], references: [id], onDelete: Cascade)
  role          SpaceMemberRole @default(MEMBER)
  status        InviteStatus    @default(PENDING)
  createdAt     DateTime        @default(now())
  expiresAt     DateTime?
  seenAt        DateTime? // set when invited user first views the invite

  @@unique([spaceId, invitedUserId])
  @@index([invitedUserId])
  @@index([spaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AiAgent
// One agent per Space. Owns all advice and (future) memory for that
// Space. Created automatically when a Space is created.
// ─────────────────────────────────────────────────────────────────────────────

model AiAgent {
  id           String    @id @default(cuid())
  spaceId      String    @unique
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name         String
  // D4 — optional restriction layer for AI context assembly.
  // When empty (default), the full template manifest is used.
  // When set, the builder assembles the intersection of the template manifest
  // and these keys. Values are ContextDomain string keys (e.g. "accounts").
  // NOT the primary declaration — the domain manifest (derived from SpaceCategory
  // or, after D9, from SpaceTemplate.contextDomains) is authoritative.
  agentScope   String[]
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  adviceHistory AiAdvice[]

  @@index([spaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PlaidItem
// Stays on User — it is a credential (OAuth token), not a Space asset.
// One item per institution; a single token covers all accounts at that bank.
// Accounts derived from this item are created as FinancialAccount rows.
// ─────────────────────────────────────────────────────────────────────────────

model PlaidItem {
  id                    String                   @id @default(cuid())
  userId                String
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalItemId        String                   @unique // provider's item/connection id (Plaid item_id today)
  institutionId         String // Plaid's institution_id (e.g. "ins_3")
  institutionName       String // human-readable (e.g. "Chase")
  encryptedToken        String // AES-256-GCM encrypted access token — NEVER plaintext
  status                PlaidItemStatus          @default(ACTIVE)
  cursor                String? // /transactions/sync cursor for incremental sync
  errorCode             String? // last Plaid error code when status = ERROR
  lastSyncedAt          DateTime?
  // D2.x resume — set while an initial/resumed history import is pending or
  // has not confirmed completion; cleared to null by syncTransactionsForItem
  // once a full sync loop finishes. Non-null on an ACTIVE item = "importing"
  // (drives lib/sync/status.ts and the client auto-resume). Replaces the old
  // cursor===null heuristic, which broke once the cursor is persisted per page.
  syncIncompleteAt      DateTime?
  // Live progress counter for the first-run import, so the UI can show
  // "1,284 imported" instead of an unmoving spinner during a multi-minute pull.
  // Written once per COMPLETED page (never per row), alongside the cursor, so it
  // survives a mid-import interruption and keeps climbing across a resume rather
  // than restarting at zero. Reset to 0 only when a fresh import begins
  // (cursor == null). Meaningful only while state = "importing".
  syncImportedCount     Int                      @default(0)
  // Number of sync loops that have run to completion for this item. A first-run
  // import is not considered settled until TWO have completed: Plaid keeps
  // delivering history for minutes after the first loop returns, so clearing
  // "importing" on the first completion declared victory while data was still
  // arriving. Existing rows were backfilled to 2 by the migration so no
  // already-settled connection flips back to importing.
  completedSyncCount    Int                      @default(0)
  // History-rebuild progress (A9). Transactions landing is only half of a first
  // run: the wealth history is then rebuilt day by day across the window those
  // transactions support. That phase had NO representation — the card jumped
  // from "importing" to "Ready" while it was still running, which is the silent
  // gap users read as "it settled but nothing is there yet".
  //
  // Unlike the transaction counter, this one supports a REAL progress bar:
  // maxAvailableWealthWindow() fixes the date range BEFORE the work starts, so
  // the denominator is known up front and never moves.
  //
  // historyBuildStartedAt non-null = a rebuild is in flight (also what keeps the
  // connection in an "importing" state). Cleared when it finishes.
  historyBuildStartedAt DateTime?
  historyBuildTotalDays Int?
  historyBuildDoneDays  Int?
  // Webhook concurrency guard — set while a sync/deferred pipeline is running
  // for this item, cleared when it finishes. A conditional claim on this column
  // serializes syncs so a duplicated/racing SYNC_UPDATES_AVAILABLE webhook can
  // never run two pipelines (racing the cursor) at once. Stale-lock recovery is
  // time-based (see lib/plaid/webhook-sync.ts LOCK_TTL_MS).
  syncLockedAt          DateTime?
  // D2 Step 7B — last manual "Refresh"/"Sync Now" attempt (success or
  // failure), distinct from lastSyncedAt above (also written by the
  // scheduled sync job). Gates the manual-refresh cooldown only; the
  // scheduler never reads or writes this field.
  lastManualRefreshAt   DateTime?
  // Investments consent state — null = unknown / never derived (all Items
  // predating this column). Written by lib/plaid/refresh.ts and
  // lib/plaid/exchangeToken.ts; the future "Enable Investment Holdings" UI
  // renders when this is CONSENT_REQUIRED.
  investmentsConsent    PlaidInvestmentsConsent?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  connections             AccountConnection[] // new relation
  // V26-QUANTITY-1E′ — one row per (investment-event ingest attempt, covered account).
  investmentEventCoverage InvestmentEventCoverage[]

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// InvestmentEventCoverage (V26-QUANTITY-1E′)
//
// The ingestion record the quantity arc needs and did not have.
//
// `computeIngestWindow` builds a rolling 24-month window from `now` on every
// sync and persisted nothing: not the window, not whether the pull finished,
// not how far back it reached. Downstream, QUANTITY-1C.1 must decide whether an
// interval with no events means "nothing happened" or "nothing was imported" —
// and those look identical unless someone wrote down what was asked for and
// what came back. This model is that written record.
//
// APPEND-ONLY. One row per (attempt, covered account); rows are never updated
// or deleted, so the union of COMPLETE windows across rows is the honest answer
// to "over which dates is this account's event stream fully recorded?".
//
// The claim a COMPLETE row makes, stated exactly: the provider fully answered a
// request for [requestedFromDate, requestedToDate] — every page was fetched and
// the count reconciled against the provider's own reported total. It does NOT
// claim the provider's history reaches requestedFromDate. Plaid does not report
// where its own history begins, so a window extending past that boundary looks
// identical to one that is genuinely empty. See the arc ledger, B-7.
// ─────────────────────────────────────────────────────────────────────────────

enum InvestmentCoverageOutcome {
  /// Every page fetched and reconciled against the provider's reported total.
  COMPLETE
  /// The provider answered, but fewer rows arrived than it reported.
  PARTIAL
  /// The request failed. Nothing may be concluded about this window.
  FAILED
  /// INVESTMENT_EVENTS_ENABLED was off — the window was never requested.
  DISABLED
  /// The item lacks Investments consent.
  CONSENT_REQUIRED
  /// Plaid returned PRODUCT_NOT_READY.
  NOT_READY
}

model InvestmentEventCoverage {
  id                   String                    @id @default(cuid())
  /// Groups every row written by ONE provider request.
  attemptId            String
  plaidItemId          String
  plaidItem            PlaidItem                 @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  financialAccountId   String
  financialAccount     FinancialAccount          @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  /// The window ASKED FOR — recorded even when the request failed.
  requestedFromDate    DateTime                  @db.Date
  requestedToDate      DateTime                  @db.Date
  outcome              InvestmentCoverageOutcome
  /// The provider's `total_investment_transactions`; null when it never answered.
  reportedTotal        Int?
  /// V26-QUANTITY-1H — every row the provider REPORTED for the window arrived.
  /// This is what `COMPLETE` proves, and it is strictly weaker than "the
  /// provider holds history back to requestedFromDate": the reported total is
  /// itself window-scoped, so a window reaching past the provider's own history
  /// floor reconciles perfectly while containing nothing.
  paginationReconciled Boolean                   @default(false)
  /// Earliest / latest transaction date actually RETURNED. Null when none were.
  /// `earliestReturnedDate` is the only demonstrable evidence of where provider
  /// history begins, and it is what bounds the licensed interval. Null licenses
  /// nothing: silence is not proof of no activity.
  earliestReturnedDate DateTime?                 @db.Date
  latestReturnedDate   DateTime?                 @db.Date
  /// Rows actually received. Zero with outcome COMPLETE is the load-bearing
  /// case: it is the only evidence that an empty interval means no movement.
  fetchedCount         Int                       @default(0)
  pagesFetched         Int                       @default(0)
  detail               String?
  attemptedAt          DateTime
  createdAt            DateTime                  @default(now())

  @@index([financialAccountId, outcome, requestedFromDate])
  @@index([plaidItemId, attemptedAt])
  @@index([attemptId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Connection (D2, Phase 2 — LIVE for PLAID: rows are created/updated by
// lib/plaid/exchangeToken.ts and read by app/api/plaid/link-token; other
// provider types not yet populated).
// Provider-agnostic generalization of the credential/login layer PlaidItem
// represents today. PlaidItem is NOT migrated or modified by this step — it
// continues to serve all existing Plaid behavior unchanged. Connection exists
// so future, non-Plaid providers (wallets with xpub/watch-only, exchanges,
// brokerages, CSV) have a home that isn't shaped like Plaid.
// See docs/architecture/D2_PROVIDER_CONNECTION_ARCHITECTURE.md.
// ─────────────────────────────────────────────────────────────────────────────

model Connection {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             ProviderType
  externalConnectionId String? // provider's login/connection id, where one exists
  credential           String? // encrypted; null for MANUAL; xpub/descriptor for WALLET watch-only — NEVER a private key
  // Provider-sync TRUTH: status / lastSyncedAt / errorCode are the authoritative
  // record of a connection's sync health (WALLET included, v1.5). The
  // AccountConnection.syncStatus / lastSyncedAt fields only MIRROR this.
  status               ConnectionStatus @default(ACTIVE)
  cursor               String? // sync cursor, where the provider supports one
  errorCode            String?
  lastSyncedAt         DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  accountConnections        AccountConnection[]
  // ProviderAccountIdentity (D2) — populated (Step 1C backfill + Step 2 dual-write).
  providerAccountIdentities ProviderAccountIdentity[]
  // ImportBatch (D2 Step 4D) — populated by the import pipeline.
  importBatches             ImportBatch[]

  @@index([userId])
  @@index([provider])
}

// ─────────────────────────────────────────────────────────────────────────────
// ProviderAccountIdentity (D2, Phase 2, Step 1B schema; Step 1C-A backfilled
// PLAID rows; Step 2A added a PLAID-only dual-write — see
// app/api/plaid/exchange-token/route.ts and lib/accounts/provider-identity.ts).
// Generalizes the ad hoc provider-identity columns on FinancialAccount
// (plaidAccountId, walletAddress) into one row per (provider,
// externalAccountId). FinancialAccount's existing provider columns remain
// the source of truth and are NOT removed by this step. WALLET is not yet
// backfilled or dual-written — see
// docs/initiatives/d2/investigations/D2_STEP1C_C_WALLET_IDENTITY_COLLISION_INVESTIGATION.md. PLAID read
// cutover is COMPLETE (Steps 3C–3F): sync, refresh, reconcile, and
// exchange-token resolve identities here first, with a warn-and-fallback to the
// legacy plaidAccountId lookup whose removal is gated on a production
// observation window (D2 Step 7 Stabilization).
// See docs/architecture/D2_PROVIDER_CONNECTION_ARCHITECTURE.md §2, §8, §9.
// ─────────────────────────────────────────────────────────────────────────────

model ProviderAccountIdentity {
  id                 String           @id @default(cuid())
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  connectionId       String?
  connection         Connection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider           ProviderType
  // v1.5 provider-spine: for WALLET, externalAccountId = the public address and,
  // with connectionId → Connection, is the CANONICAL provider identity path —
  // superseding the transitional FinancialAccount.walletAddress column.
  externalAccountId  String
  metadata           Json?
  createdAt          DateTime         @default(now())

  // D2 Step 1D — multi-account correction. A provider identity (e.g. a
  // wallet address) is a public external fact; a FinancialAccount is a
  // private Fourth Meridian object. Multiple FinancialAccount rows
  // (different owners' private interpretations of the same address, or
  // future public/watch-Space interpretations) may legitimately share one
  // externalAccountId — each gets its own row here, distinguished by
  // financialAccountId. The constraint below was previously
  // @@unique([provider, externalAccountId]) alone, which made that
  // impossible (at most one FinancialAccount could ever hold a given
  // identity, globally). See
  // docs/initiatives/d2/implementation/D2_STEP1D_PROVIDER_ACCOUNT_IDENTITY_MULTI_ACCOUNT_CORRECTION.md.
  // PLAID is unaffected: FinancialAccount.plaidAccountId already carries its
  // own independent @unique, so this relaxation doesn't change PLAID's
  // real-world uniqueness guarantee.
  @@unique([provider, externalAccountId, financialAccountId])
  // Wallet Provider v4 (xpub) — the previous @@unique([provider,
  // financialAccountId]) was DROPPED here. It allowed at most one identity per
  // (provider, account), which blocks an xpub wallet's many addresses (one
  // ProviderAccountIdentity per discovered address, all under one
  // FinancialAccount). Single-identity providers keep their invariant at the
  // APPLICATION level: dualWriteProviderAccountIdentity() still find-by-
  // {provider, financialAccountId}+upsert (Plaid + single-address wallets), and
  // PLAID's real-world uniqueness is independently guaranteed by
  // FinancialAccount.plaidAccountId @unique. The retained composite unique above
  // still prevents the SAME address twice on one account. Blast-radius verified:
  // no code keys on the dropped compound unique, and no account read path joins
  // ProviderAccountIdentity (visibility is SpaceAccountLink).
  @@index([financialAccountId])
  @@index([connectionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Legacy `Account` model (PCS-3B, 2026-07-16): physically retired. All account
// truth is now FinancialAccount + AccountConnection + SpaceAccountLink (with
// ProviderAccountIdentity where applicable). Transaction and Holding anchor
// solely on financialAccountId. No compatibility bridge or fallback remains.
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// FinancialAccount
// Canonical representation of a single real-world financial account.
// One row per real-world account — never duplicated.
// ownerType / ownerUserId / ownerSpaceId track who "owns" the account
// in the Fourth Meridian sense (not necessarily the legal bank account holder).
// Balance values here are always canonical — sourced from the isCanonical
// AccountConnection on each sync cycle.
// ─────────────────────────────────────────────────────────────────────────────

model FinancialAccount {
  id           String           @id @default(cuid())
  ownerType    AccountOwnerType
  ownerUserId  String?
  ownerUser    User?            @relation("UserOwnedFinancialAccounts", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerSpaceId String?
  ownerSpace   Space?           @relation("SpaceOwnedFinancialAccounts", fields: [ownerSpaceId], references: [id], onDelete: SetNull)

  // D11 (Phase 2 schema modernization): the human-accountable party independent
  // of the visibility owner. For ownerType=USER this is normally the same
  // person as ownerUserId; for ownerType=SPACE, ownerUserId is null by design
  // (visibility, not accountability), so this field is the only required
  // answer to "who connected this account on behalf of the Space." Additive,
  // nullable — backfilled from ownerUserId (falling back to the earliest
  // AccountConnection.connectedByUserId) for existing rows; set at creation
  // time for every new FinancialAccount going forward.
  createdByUserId String?
  createdByUser   User?   @relation("FinancialAccountCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Canonical values — written by the AccountConnection with isCanonical = true
  name                 String
  type                 AccountType
  institution          String
  institutionId        String? // Plaid institution_id (e.g. "ins_3")
  mask                 String? // last 4 digits of account number
  balance              Float       @default(0)
  availableBalance     Float?
  creditLimit          Float?
  currency             String      @default("USD")
  lastUpdated          DateTime    @default(now())
  // D4 Balance Freshness Provenance — the timestamp Plaid reported for when
  // the balance itself was last fetched from the institution. Distinct from
  // lastUpdated (which records when Fourth Meridian wrote to this row).
  // Populated from AccountBalance.last_updated_datetime on each Plaid refresh;
  // null for institutions that do not supply this field (currently most — Plaid
  // documents support only for ins_128026 / Capital One, but the field is typed
  // as optional on all AccountBalance responses). Never backfilled for existing
  // rows; null means "provenance unknown", not "balance is current".
  balanceLastUpdatedAt DateTime?

  // Plaid deduplication key
  plaidAccountId String? @unique

  // Display name metadata (additive — never overwritten by Plaid sync after creation).
  // Resolution order for what to show the user: displayName ?? officialName ?? plaidName ?? name.
  // `institution` (above) already serves as the human-readable institution name
  // (e.g. "Chase"), so no separate institutionName column was added.
  plaidName    String? // raw Plaid `name` value, captured once at import — never updated on resync
  officialName String? // Plaid `official_name`, captured once at import — never updated on resync
  displayName  String? // user-editable override; null until the user renames the account

  // Crypto self-custody fields — TRANSITIONAL (v1 / v1.5 wallet columns).
  // Canonical provider identity for a wallet is
  // ProviderAccountIdentity(provider=WALLET).externalAccountId linked to a
  // Connection(provider=WALLET) (v1.5 provider-spine alignment). walletAddress /
  // walletChain are still the de-facto read/write source today, but no NEW
  // readers should be added — v2+ migrates reads onto the identity/Connection
  // path. nativeBalance (and, for crypto accounts, the USD `balance` above) are
  // written by balance sync in v1/v1.5 and become DERIVED from Holding rows in
  // v2 (Σ Holding.value); the scalar columns remain for non-crypto accounts.
  walletAddress String?
  walletChain   String?
  nativeBalance Float?

  // Debt-specific fields (optional — populated for credit cards, loans, lines of credit)
  // Legacy flat fields — kept for backward compatibility with existing UI/queries.
  // New debt-profile data (APR, due date, statement close day, promo APR, notes)
  // lives on the DebtProfile relation below; effective values prefer DebtProfile
  // when present and fall back to these flat columns otherwise.
  debtSubtype    String? // e.g. credit_card, line_of_credit, heloc, auto_loan, mortgage, personal_loan, student_loan
  interestRate   Float? // Annual Percentage Rate (APR), e.g. 19.99
  minimumPayment Float? // Minimum monthly payment amount

  syncStatus String?   @default("pending")
  deletedAt  DateTime? // soft delete — preserves history

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections              AccountConnection[]
  // SpaceAccountLink (D3) — the sole account-link path since WorkspaceAccountShare
  // was retired (v2.5-A Phase 4c).
  spaceAccountLinks        SpaceAccountLink[]
  duplicateCandidatesA     DuplicateAccountCandidate[] @relation("DuplicateCandidateA")
  duplicateCandidatesB     DuplicateAccountCandidate[] @relation("DuplicateCandidateB")
  goalContributions        GoalContribution[]
  debtProfile              DebtProfile?
  transactions             Transaction[]               @relation("FinancialAccountTransactions")
  // L8 — logical economic events on this account (banking only).
  transactionEvents        TransactionEvent[]          @relation("AccountTransactionEvents")
  holdings                 Holding[]
  // A1 — append-only investment position history (dark-write; Holding stays the
  // current-state read model). Additive back-relation only.
  positionObservations     PositionObservation[]
  // A3 — canonical inside-the-investment-account activity log (dark-write).
  investmentEvents         InvestmentEvent[]
  // A4 — one-time position-reconstruction summaries (dark-write). Additive.
  positionReconstructions  PositionReconstruction[]
  // ProviderAccountIdentity (D2) — populated (Step 1C backfill + Step 2 dual-write).
  providerIdentities       ProviderAccountIdentity[]
  // ImportBatch (D2 Step 4D) — populated by the import pipeline.
  importBatches            ImportBatch[]
  // FlowType (v2.5.5 P3) — transactions whose counterparty ("other side") is
  // this account. Relation-only back-reference; populated from P4 onward.
  counterpartyTransactions Transaction[]               @relation("TransactionCounterpartyAccount")

  // V26-QUANTITY-1E′ — ingestion-coverage record for investment events.
  investmentEventCoverage InvestmentEventCoverage[]

  @@index([ownerUserId])
  @@index([ownerSpaceId])
  @@index([createdByUserId])
  @@index([type])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// DebtProfile
// Additive, optional 1:1 extension of FinancialAccount for debt details Plaid
// does not reliably provide (APR, minimum payment, due date, statement close
// day, promotional APR expiration). Kept as a separate model rather than more
// columns on FinancialAccount per the "dedicated debt profile" design — every
// field is nullable; creating this table does not touch any existing column.
// ─────────────────────────────────────────────────────────────────────────────

model DebtProfile {
  id                 String           @id @default(cuid())
  financialAccountId String           @unique
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  apr               Float? // user-entered APR, e.g. 24.99 — preferred over FinancialAccount.interestRate when set
  minimumPayment    Float? // user-entered minimum payment — preferred over FinancialAccount.minimumPayment when set
  dueDay            Int? // day of month payment is due (1-31)
  statementCloseDay Int? // day of month the statement closes (1-31)
  promoAprEndDate   DateTime? @db.Date // when a promotional/intro APR expires
  notes             String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financialAccountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AccountConnection
// Represents one user's connection to a FinancialAccount via a specific source
// (Plaid, manual entry, crypto wallet, etc.).
// isCanonical = true means this connection is the authoritative source for
// balance updates written back to FinancialAccount.
// Multiple connections to the same FinancialAccount are allowed (e.g. two
// spouses both have Plaid access to the same joint checking account).
// ─────────────────────────────────────────────────────────────────────────────

model AccountConnection {
  id                 String           @id @default(cuid())
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  connectedByUserId  String
  connectedByUser    User             @relation("UserConnectedAccounts", fields: [connectedByUserId], references: [id], onDelete: Cascade)

  // Source credentials — exactly one of plaidItemDbId or (walletAddress) will be set
  plaidItemDbId String?
  plaidItem     PlaidItem? @relation(fields: [plaidItemDbId], references: [id], onDelete: SetNull)

  // D2 — populated for PLAID by lib/plaid/exchangeToken.ts alongside
  // plaidItemDbId. Parallel path to plaidItemDbId for future non-Plaid
  // providers; existing Plaid/manual/wallet behavior unchanged.
  connectionId String?
  connection   Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  // MIRROR (compatibility): the provider-sync truth is Connection.status /
  // lastSyncedAt. For WALLET these are refreshed on a successful balance sync
  // (v1.5: markWalletAccountConnectionSynced); some providers may not maintain
  // them — do not treat these as authoritative.
  syncStatus   String    @default("pending")
  isCanonical  Boolean   @default(true) // authoritative balance source for this account
  lastSyncedAt DateTime?
  deletedAt    DateTime? // soft delete on account removal; preserves Holding/Transaction history

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financialAccountId])
  @@index([connectedByUserId])
  @@index([plaidItemDbId])
  @@index([connectionId])
  @@index([financialAccountId, isCanonical])
}

// WorkspaceAccountShare (retired v2.5-A Phase 4c) — model dropped after the D3
// SAL backfill + read cutover completed and the Phase 0 gates confirmed every
// WAS row was mirrored into SpaceAccountLink. A pre-drop pg_dump of the table
// is the recovery artifact (attached to the retirement PR); WAS rows are also
// 1:1 reconstructable from SAL kind=SHARED rows.

// ─────────────────────────────────────────────────────────────────────────────
// SpaceAccountLink (D3, Phase 2 → completed v2.5-A) — the sole account-link
// path: consolidates the retired WorkspaceAccountShare and FinancialAccount's
// ownerSpaceId/ownerUserId declared-owner pair into a single polymorphic link.
// kind=HOME replaces the declared-owner pair, kind=SHARED replaces the old
// WorkspaceAccountShare row. One row per (space, financialAccount) pair.
// A REVOKED link means the account is no longer visible to that space —
// typically triggered when the member who shared it is removed or leaves.
// See docs/initiatives/d3/D3_SPACE_ACCOUNT_LINK_REVIEW.md for the migration
// history and docs/investigations/V25A_PHASE0_SEAM_RETIREMENT_READINESS.md
// for the retirement gates.
// ─────────────────────────────────────────────────────────────────────────────
model SpaceAccountLink {
  id                 String               @id @default(cuid())
  spaceId            String
  space              Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  financialAccountId String
  financialAccount   FinancialAccount     @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  kind               SpaceAccountLinkKind
  // OPS-2 S5 — nullable + SetNull (was required + Cascade). SAL doctrine is
  // revoke-don't-delete (status: REVOKED exists for exactly this); a hard
  // cascade on the adder's deletion would orphan accounts (including HOME
  // links) that other members rely on. The S7 pipeline revokes via status;
  // the FK then nulls harmlessly. Null addedByUserId = "adder's account no
  // longer exists" — the share-revoke route's self-check is null-safe (a
  // nulled adder simply requires OWNER/ADMIN to revoke).
  // See docs/initiatives/ops2/OPS2_S5_DELETION_INVENTORY.md.
  addedByUserId      String?
  addedByUser        User?                @relation("SpaceAccountLinkAdder", fields: [addedByUserId], references: [id], onDelete: SetNull)
  visibilityLevel    VisibilityLevel      @default(FULL)
  status             ShareStatus          @default(ACTIVE)
  revokedAt          DateTime?
  revokedByUserId    String?
  revokedByUser      User?                @relation("SpaceAccountLinkRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, financialAccountId])
  @@index([spaceId, status])
  @@index([financialAccountId, status])
  @@index([financialAccountId, kind])
  @@index([addedByUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DuplicateAccountCandidate
// Audit ledger of automatic duplicate-account merges performed by
// lib/accounts/reconcile.ts (mergeArchivedDuplicateIntoCanonical). Rows are
// written AFTER a merge has already happened — this table does not gate or
// block any merge, and nothing reads it back yet (no review UI exists).
// D1 (see docs/initiatives/d1/D1_DUPLICATE_ACCOUNT_CANDIDATE_DESIGN_REVIEW.md) repurposed
// this model from an unused human-review-queue design — the original comment
// here claimed "NEVER auto-merges," which was already false of the running
// code before D1 — into the audit ledger described above.
// ─────────────────────────────────────────────────────────────────────────────

model DuplicateAccountCandidate {
  id               String                   @id @default(cuid())
  // Nullable: mergeArchivedDuplicateIntoCanonical doesn't always have a space
  // in scope (the restore routes resolve by account ownership, not by Space).
  // A merge is a fact about an account pair, not inherently scoped to one
  // Space. Populated when the caller has a space in context (e.g. Plaid
  // import); null otherwise (e.g. the generic/manual restore routes).
  spaceId          String?
  // Directional by convention, not by name: accountA is always the
  // surviving canonical ("winner") row, accountB is always the archived row
  // whose history was folded into it ("loser"). See
  // mergeArchivedDuplicateIntoCanonical in lib/accounts/reconcile.ts.
  accountAId       String
  accountA         FinancialAccount         @relation("DuplicateCandidateA", fields: [accountAId], references: [id], onDelete: Cascade)
  accountBId       String
  accountB         FinancialAccount         @relation("DuplicateCandidateB", fields: [accountBId], references: [id], onDelete: Cascade)
  status           DuplicateStatus          @default(PENDING)
  detectionSource  DuplicateDetectionSource
  detectedAt       DateTime                 @default(now())
  // resolvedAt/resolvedByUserId predate D1 and still read as "a human
  // reviewed this." For every row written by the automatic merge path,
  // resolvedByUserId is null (no human in the loop) and resolvedAt is set to
  // the same instant as detectedAt — there is no review gap to measure.
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedByUser   User?                    @relation("DuplicateResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Kept as a true unique constraint, not relaxed to append-only: a later
  // re-merge of the same (winner, loser) pair (e.g. a second restore attempt
  // on an already-merged loser) upserts this row (bumping detectedAt)
  // instead of inserting a second one. See lib/accounts/reconcile.ts.
  @@unique([accountAId, accountBId])
  @@index([spaceId, status])
  @@index([accountAId])
  @@index([accountBId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SpaceGoal (renamed from WorkspaceGoal)
// A financial goal belonging to a Space. Members contribute accounts to the
// goal via GoalContribution. Progress is computed from the sum of contributing
// account balances (or a subset of those balances).
// ─────────────────────────────────────────────────────────────────────────────

model SpaceGoal {
  id              String       @id @default(cuid())
  spaceId         String
  space           Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  // OPS-2 S5 — nullable + SetNull (was required + Cascade). A goal created in
  // a SHARED Space is the Space's data, not the creator's: deleting the
  // creator must never destroy other members' goals, contributions, or
  // check-ins. Null createdByUserId = "creator's account no longer exists".
  // See docs/initiatives/ops2/OPS2_S5_DELETION_INVENTORY.md.
  createdByUserId String?
  createdBy       User?        @relation("GoalCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  category        GoalCategory @default(GENERAL)
  goalType        GoalType     @default(FINANCIAL)
  status          GoalStatus   @default(ACTIVE)

  // ── FINANCIAL fields ──────────────────────────────────────────────────────
  targetAmount  Float? // required for FINANCIAL & SPENDING_LIMIT
  currentAmount Float     @default(0) // denormalized — updated by sync job
  targetDate    DateTime? @db.Date

  // ── HABIT fields ──────────────────────────────────────────────────────────
  habitFrequency String? // DAILY | WEEKLY | MONTHLY
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastCheckIn    DateTime?

  // ── SPENDING_LIMIT fields ─────────────────────────────────────────────────
  spendingCategory String? // free-text category label

  // ── DEBT_REDUCTION fields ─────────────────────────────────────────────────
  linkedAccountId       String? // FK to FinancialAccount (soft ref — no cascade)
  targetReductionAmount Float? // pay down by $X
  targetReductionPct    Float? // pay down by X%
  snapshotBalance       Float? // balance at goal creation (for progress calc)

  completedAt DateTime?
  archivedAt  DateTime? // set when goal is archived
  deletedAt   DateTime? // soft delete — set when moved to trash

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributions GoalContribution[]
  checkIns      GoalCheckIn[]

  @@index([spaceId, status])
  @@index([spaceId, category])
  @@index([spaceId, goalType])
}

// ─────────────────────────────────────────────────────────────────────────────
// GoalCheckIn
// Records each manual check-in for HABIT goals. Used for streak calculation.
// ─────────────────────────────────────────────────────────────────────────────

model GoalCheckIn {
  id        String    @id @default(cuid())
  goalId    String
  goal      SpaceGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  note      String?
  checkedAt DateTime  @default(now())

  @@index([goalId])
  @@index([goalId, checkedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// GoalContribution
// Links a FinancialAccount to a SpaceGoal. includeBalance controls whether
// the account's balance counts toward the goal's currentAmount.
// ─────────────────────────────────────────────────────────────────────────────

model GoalContribution {
  id                 String           @id @default(cuid())
  goalId             String
  goal               SpaceGoal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  includeBalance     Boolean          @default(true)

  createdAt DateTime @default(now())

  @@unique([goalId, financialAccountId])
  @@index([goalId])
  @@index([financialAccountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SpaceDashboardSection (renamed from WorkspaceDashboardSection)
// Controls which sections/cards appear on the Space planning dashboard and
// in what order. Generated automatically from the Space category preset on
// Space creation. Members with OWNER/ADMIN role can toggle, reorder, or
// add custom sections.
// key: machine-readable identifier (e.g. "net_worth", "debt_payoff_tracker")
// label: display name shown in the UI (overrideable by user)
// tab: which dashboard tab this section appears under
// enabled: false hides the section without deleting it
// order: ascending sort order within the tab
// config: arbitrary JSON for section-specific settings (e.g. chart type, filters)
// ─────────────────────────────────────────────────────────────────────────────

model SpaceDashboardSection {
  id      String            @id @default(cuid())
  spaceId String
  space   Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  key     String // e.g. "net_worth", "goals_progress", "debt_payoff"
  label   String // display label
  tab     SpaceDashboardTab @default(OVERVIEW)
  enabled Boolean           @default(true)
  order   Int               @default(0)
  config  Json? // section-specific settings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, key])
  @@index([spaceId, tab])
  @@index([spaceId, enabled])
}

// ─────────────────────────────────────────────────────────────────────────────
// Holding
// One row per position (stock / ETF / crypto) per account.
//
// Holdings anchor solely on financialAccountId (PCS-3B — legacy Account FK
// retired). One position row per (financialAccount, symbol).
// ─────────────────────────────────────────────────────────────────────────────

model Holding {
  id String @id @default(cuid())

  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  symbol    String
  name      String
  quantity  Float
  price     Float
  value     Float
  change24h Float   @default(0)
  // Synthetic row written by sync job: account.balance − sum(real positions).
  isCash    Boolean @default(false)

  // MC1 Phase 0 — ISO 4217 code of `price` and `value` (the fiat valuation
  // unit — for crypto positions this is the quote currency, not the asset;
  // quantity stays unitless). Same null semantics as Transaction.currency.
  currency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([financialAccountId, symbol])
  @@index([financialAccountId])
  @@index([financialAccountId, isCash])
}

// ─────────────────────────────────────────────────────────────────────────────
// Investment Observation Foundation (Slice A1)
//
// Canonical investment instrument identity + append-only position history.
// Purely additive and dark-write (gated behind INVESTMENT_OBSERVATIONS_ENABLED):
// `Holding` remains the current-state read model, untouched. Instruments are
// deployment-global public facts (like Merchant/FxRate) — visibility gating
// stays on positions via financialAccountId. See
// FOURTH_MERIDIAN_INVESTMENT_HISTORY_PROGRESSIVE_EVIDENCE_IMPLEMENTATION_PLAN_2026-07-11.md
// §4.3 / §6.2. FIGI intentionally absent — plaid@42.2.0 Security does not expose it.
// ─────────────────────────────────────────────────────────────────────────────

enum AssetClass {
  EQUITY
  ETF
  MUTUAL_FUND
  FIXED_INCOME
  OPTION
  CRYPTO
  CASH
  OTHER
  UNKNOWN
}

model Instrument {
  id                     String     @id @default(cuid())
  // Strong identifiers — nullable; null = never provided (MC1 doctrine).
  cusip                  String?    @unique
  isin                   String?    @unique
  sedol                  String?
  // Display / weak identity — never the canonical primary key.
  tickerSymbol           String?
  name                   String?
  assetClass             AssetClass @default(UNKNOWN)
  // Provider-reported metadata, preserved not interpreted.
  securityType           String?
  securitySubtype        String?
  marketIdentifierCode   String?
  currency               String?
  sector                 String?
  industry               String?
  cfiCode                String?
  isCashEquivalent       Boolean?
  isHoldable             Boolean    @default(true)
  status                 String     @default("ACTIVE") // ACTIVE | DELISTED
  optionMeta             Json? // raw Plaid option_contract
  fixedIncomeMeta        Json? // raw Plaid fixed_income
  underlyingInstrumentId String?
  supersededById         String? // symbol-change / merge pointer — never delete
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  aliases          InstrumentAlias[]
  positions        PositionObservation[]
  events           InvestmentEvent[]
  reconstructions  PositionReconstruction[]
  prices           PriceObservation[]
  corporateActions CorporateActionTerms[]

  @@index([tickerSymbol])
  @@index([assetClass])
}

// Provider identity mapping — the ProviderAccountIdentity/MerchantAlias twin.
model InstrumentAlias {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  provider     String // "plaid" | "coinbase" | "schwab" | "csv" | "wallet" | "manual"
  externalId   String // e.g. Plaid security_id; CSV symbol key; wallet asset id
  metadata     Json? // e.g. institution_security_id, proxy_security_id, bootstrap flag
  createdAt    DateTime   @default(now())

  @@unique([provider, externalId]) // refuse the second mapping (MerchantAlias doctrine)
  @@index([instrumentId])
}

enum PositionOrigin {
  OBSERVED
  IMPORTED
  DERIVED
  USER_ASSERTED
}

model PositionObservation {
  id                 String           @id @default(cuid())
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  instrumentId       String
  instrument         Instrument       @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  date     DateTime       @db.Date
  quantity Float
  origin   PositionOrigin
  source   String // "plaid" | "csv:schwab" | "user" | "reconstruction"

  // Observed-only valuation facts (never on DERIVED rows).
  institutionPrice     Float?
  institutionValue     Float?
  institutionPriceAsOf DateTime? @db.Date
  costBasis            Float? // Plaid holding-level aggregate cost basis
  vestedQuantity       Float?
  currency             String?
  isCash               Boolean   @default(false)

  // Derived-only reconstruction provenance — left null this slice (MC1 doctrine).
  reconstructionVersion Int?
  completeness          String?
  unexplainedQuantity   Float?
  evidenceRefs          Json?

  // A7-1 — historical-import provenance (additive, nullable; MC1: null = never
  // provided, never inferred). Imported/asserted rows (origin IMPORTED /
  // USER_ASSERTED) join their ImportBatch; batch rollback soft-deletes them via
  // deletedAt, and every observation read path filters `deletedAt: null`
  // (reconstruction-runner, reconstruction-read, position-capture). SetNull so a
  // deleted batch never deletes the observation history it recorded. No writer
  // exists yet — A7-2 (manual assertion) / A7-4 (import commit) land those.
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  deletedAt     DateTime?

  supersededById String?
  createdAt      DateTime @default(now())

  @@unique([financialAccountId, instrumentId, date, origin, source])
  @@index([financialAccountId, instrumentId, date])
  @@index([financialAccountId, date])
  @@index([importBatchId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Investment Event Foundation (Slice A3)
//
// The canonical inside-the-investment-account activity log. One additive table
// that is simultaneously the provider provenance record AND the canonical
// projection (the Transaction.pfc* pattern) — raw provider strings live on-row
// beside normalized canonical fields. Additive + dark-write (gated behind
// INVESTMENT_EVENTS_ENABLED); nothing reads it yet. Holding stays the
// current-state read model; PositionObservation stays the position-evidence
// store; InvestmentEvent is the activity log consumed later by A4 reconstruction.
// Provider strings enter only through the pure stage-1 mapper
// (lib/investments/plaid-investment-events.ts). See
// FOURTH_MERIDIAN_A3_INVESTMENT_EVENT_FOUNDATION_INVESTIGATION_2026-07-11.md §4/§5.
// FIGI intentionally absent (plaid@42.2.0 does not provide it).
// ─────────────────────────────────────────────────────────────────────────────

enum InvestmentEventType {
  BUY
  SELL
  CONTRIBUTION
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  DIVIDEND
  INTEREST
  CAPITAL_GAIN
  REINVESTMENT
  FEE
  TAX
  SPLIT
  MERGER
  SPIN_OFF
  SYMBOL_CHANGE // imports / corporate-action data only — never from Plaid
  OPENING_BALANCE // user-asserted / imported opening anchor
  CANCEL
  ADJUSTMENT
  OTHER
  UNKNOWN
}

model InvestmentEvent {
  id                 String           @id @default(cuid())
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  instrumentId       String?
  instrument         Instrument?      @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  type     InvestmentEventType
  date     DateTime            @db.Date // posting / settlement date (Plaid `date`)
  datetime DateTime? // Plaid transaction_datetime when provided
  quantity Float? // security units, signed: + units in / − units out
  price    Float?
  amount   Float? // cash leg, FM sign: + cash into account / − cash out
  fees     Float? // stored >= 0 (a cost), or null = not provided
  currency String? // ISO 4217 / unofficial code; null = never provided

  // Provenance — raw provider facts on-row (Transaction.pfc* pattern).
  source             String // "plaid" | "csv:<profile>" | "user" | "coinbase" | …
  externalEventId    String? // Plaid investment_transaction_id / file row id
  providerType       String? // raw Plaid type — verbatim
  providerSubtype    String? // raw Plaid subtype — verbatim
  providerSecurityId String? // raw Plaid security_id — survives resolver failure
  description        String? // raw institution `name` — verbatim
  mapperVersion      Int? // stage-1 adapter version (classifierVersion pattern)

  // Corporate-action shape (nullable; Plaid supplies neither — imports/manual do).
  relatedInstrumentId String?
  ratio               Float?

  // Import / assertion provenance.
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdByUserId String?
  // A7-1 — the complete original imported row (header→cell strings, untyped),
  // including lot detail we deliberately refuse to interpret. Null = not an
  // import (MC1; Plaid rows keep their raws in the provider columns above). No
  // writer exists yet — A7-4 (import commit) lands it.
  importedRaw     Json?

  // Correction / supersession — append-only doctrine.
  supersededById String?
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalEventId]) // provider dedupe; nulls exempt (manual rows)
  @@index([financialAccountId, date])
  @@index([financialAccountId, instrumentId, date])
  @@index([instrumentId, date])
  @@index([importBatchId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Position Reconstruction summary (Slice A4-2)
//
// One row per (account, instrument): the outcome of the one-time backward walk
// (lib/investments/reconstruction-core.ts) over OBSERVED anchors + canonical
// InvestmentEvents. Additive + dark-write (gated behind
// INVESTMENT_RECONSTRUCTION_ENABLED); the DERIVED position rows themselves are
// PositionObservation(origin: DERIVED, source: "reconstruction") — this table is
// the queryable per-position reconciliation summary the read model and Wealth
// regeneration consume. `reconciliation` is a JOB outcome (COMPLETE|PARTIAL|
// FAILED + failureReason); `completeness` is the separate canonical A5-S1 trust
// tier for consumers (never conflated — parallelization investigation §4). The
// unexplained opening residual is a first-class number, NEVER forced to zero.
// See FOURTH_MERIDIAN_INVESTMENT_HISTORY_PROGRESSIVE_EVIDENCE_IMPLEMENTATION_PLAN
// §7.3 / §7.4.
// ─────────────────────────────────────────────────────────────────────────────

enum ReconstructionStatus {
  COMPLETE // opening residual ≈ 0, no stops
  PARTIAL // nonzero residual or unmatched cancel — an unexplained opening remains
  FAILED // reconstruction stopped at an uninvertible corporate action / unknown
}

model PositionReconstruction {
  id                 String           @id @default(cuid())
  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  instrumentId       String
  instrument         Instrument       @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  earliestDefensibleDate     DateTime @db.Date
  observedCurrentQuantity    Float
  openingQuantity            Float
  unexplainedOpeningQuantity Float // persisted, NEVER forced to 0

  reconciliation ReconstructionStatus
  failureReason  String? // e.g. UNSUPPORTED_CORPORATE_ACTION — null unless FAILED/degraded
  completeness   String // canonical A5-S1 tier ("derived" | "incomplete") — write-time guarded
  conflicted     Boolean              @default(false) // unmatched CANCEL on the walk

  reconstructionVersion Int
  eventCount            Int
  evidenceRefs          Json? // anchor observation id + contributing InvestmentEvent ids
  runAt                 DateTime @default(now())

  @@unique([financialAccountId, instrumentId]) // one live summary per position (upserted on rerun)
  @@index([financialAccountId])
  @@index([instrumentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Corporate Action Terms (V26-S1-CA)
//
// WHAT HAPPENED TO A SECURITY, AND WHO SAYS SO.
//
// A backward quantity replay can only invert a corporate action whose TERMS it
// knows. Plaid emits the EVENT (`transfer`/`split` → InvestmentEventType.SPLIT)
// but never the terms — every SPLIT row in the live corpus carries `ratio` NULL
// — so `reconstruction-core.stopReasonFor` halts the walk and the position keeps
// UNSUPPORTED_CORPORATE_ACTION. Measured locally: TQQQ's history stops dead at
// 2025-11-20.
//
// The terms were never actually missing. Tiingo's daily-prices response — the
// SAME HTTP call lib/prices/providers/tiingo.ts already makes for every equity
// and ETF — carries `splitFactor` on every row, and states 2.0 on exactly that
// date. The adapter typed its row as `{ date, close }` and discarded it.
//
// WHY A TABLE, NOT A COLUMN ON InvestmentEvent:
//   · Terms are a property of the SECURITY, not of one account's row. Every
//     holder of TQQQ experienced the same 2:1; storing it per event would write
//     the same fact N times and let two accounts disagree about the market.
//   · Deployment-global, exactly like Instrument and PriceObservation — one
//     vendor answer serves every user, which is the same economics that made the
//     global price archive right.
//   · An action can exist with NO event: a security can split while a provider
//     never reports it. Terms can still license the replay; an event column
//     could not.
//   · InvestmentEvent.ratio stays what its schema comment says it is — a term
//     the IMPORT or the USER stated. Writing a vendor-derived value there would
//     give one column two meanings and no way to tell them apart.
//
// GRADE is the load-bearing field. Only terms an INDEPENDENT SOURCE STATES may
// license an inversion:
//   STATED        the user or an imported statement stated it
//   CORROBORATED  a price vendor stated it (Tiingo splitFactor)
// A ratio our own arithmetic merely IMPLIES (e.g. dividing the event's quantity
// into the post-action holding) is deliberately NOT persistable here: one
// observation cannot establish whether a provider reports a split as a delta, a
// new total, or a paired remove/add, and a plausible guess is exactly what the
// UNSUPPORTED_CORPORATE_ACTION refusal exists to prevent.
//
// Unique on (instrument, date, kind, source) rather than (instrument, date,
// kind): two sources stating the same action is EVIDENCE, and collapsing them
// would discard a disagreement worth surfacing. The reader picks deterministically
// by grade — see lib/investments/corporate-actions.core.ts.
// ─────────────────────────────────────────────────────────────────────────────

model CorporateActionTerms {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  /// The date the action took effect (the vendor's stated effective date).
  effectiveDate DateTime @db.Date
  /// "SPLIT" today. Reserved-String, guarded at write time — the same pattern as
  /// PositionObservation.completeness; never a parallel enum vocabulary.
  kind          String
  /// Shares out per share in. 2.0 = a 2:1 forward split; 0.1 = a 1:10 reverse.
  ratio         Float?
  /// "STATED" | "CORROBORATED" — write-time guarded. Never "INFERRED".
  grade         String
  /// Provenance, e.g. "tiingo:splitFactor" | "import" | "user".
  source        String
  /// The raw vendor row / stated terms this was read from. Evidence, not input.
  evidenceRefs  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instrumentId, effectiveDate, kind, source])
  @@index([instrumentId, effectiveDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Historical Price Foundation (Slice A8-1)
//
// Append-only historical-price facts, keyed by Instrument identity — never a
// ticker (symbol changes/delistings/reuse are solved by Instrument/
// InstrumentAlias; the price series inherits that solution). Structural twin of
// FxRate: one canonical row per (instrument, date, basis); `source` is
// provenance, not identity; closed dates only; immutable. `basis` isolates
// distinct series (RAW_CLOSE for valuation; ADJUSTED_CLOSE for charts; NAV for
// funds; CRYPTO_DAILY; INTRADAY reserved) — reads never mix bases. `currency` is
// the QUOTE currency; NO converted or valuation fields live here (that is A8-4,
// derived at read time). No ticker, no provider identity key, no confidence, no
// interpolated rows. Consumed by A8-2 capture, A8-3 backfill, A8-4 valuation,
// A9 regeneration, A10. See FOURTH_MERIDIAN_A6_A7_A8_P5_PARALLELIZATION §3 and
// FOURTH_MERIDIAN_INVESTMENT_HISTORY_PROGRESSIVE_EVIDENCE_IMPLEMENTATION_PLAN §9.
// ─────────────────────────────────────────────────────────────────────────────

enum PriceBasis {
  RAW_CLOSE // unadjusted market close — THE canonical valuation series
  ADJUSTED_CLOSE // split/dividend-adjusted — charting only, never mixed into valuation
  NAV // mutual-fund net asset value
  INTRADAY // within-session price (reserved)
  CRYPTO_DAILY // stated UTC daily close for crypto assets
}

model PriceObservation {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  date      DateTime   @db.Date // market close date, daily granularity
  price     Float // quote-currency close (positive-finite; never adjusted-mixed)
  currency  String // ISO 4217 quote currency of `price`
  basis     PriceBasis
  source    String // provider that supplied the batch — provenance, not identity
  fetchedAt DateTime   @default(now())
  createdAt DateTime   @default(now())

  // Determinism anchor: ONE canonical row per (instrument, date, basis) —
  // deliberately not per source; which provider supplied it is provenance.
  @@unique([instrumentId, date, basis])
  // Walk-back / as-of reads: latest date ≤ asked, per (instrument, basis).
  @@index([instrumentId, basis, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// FlowType semantics (v2.5.5 Financial Intelligence — Transaction Semantics)
// Native enums promoted 1:1 from the P1 classifier's TypeScript unions
// (lib/transactions/flow-classifier.ts). Additive; Phase A adds the types and
// nullable columns only — no write-time population, backfill, or read cutover.
// See docs/initiatives/flowtype/P3_SCHEMA_DESIGN_INVESTIGATION.md.
// ─────────────────────────────────────────────────────────────────────────────

/// Economic KIND of a transaction (the canonical flow-semantics field).
enum FlowType {
  SPENDING
  INCOME
  REFUND
  DEBT_PAYMENT
  TRANSFER
  INVESTMENT
  FEE
  INTEREST
  ADJUSTMENT
  UNKNOWN
}

/// Economic DIRECTION, decoupled from the per-account amount sign.
enum FlowDirection {
  INFLOW
  OUTFLOW
  INTERNAL
  UNKNOWN
}

/// Stable, auditable reason a row received its flow classification.
enum FlowClassificationReason {
  PLAID_PFC_DETAILED
  PLAID_PFC_PRIMARY
  CATEGORY_FLOW_VALUE
  CATEGORY_INVESTMENT_VALUE
  ACCOUNT_TYPE_CONTEXT
  SIGN_DEFAULT_SPENDING
  SIGN_DEFAULT_INFLOW
  AMBIGUOUS_UNKNOWN
  /// SR-4 — a deterministic DESCRIPTOR-EVIDENCE resolver (not the descriptor-blind
  /// classifier) decided the economic kind by promoting the "Other" sentinel to a
  /// real category (e.g. an ACH "PAYROLL SEC:PPD" credit → Income → INCOME). Stamped
  /// by the write layer AFTER classifyFlow; the classifier never emits it. This makes
  /// "we know this because the descriptor said so" permanently auditable/greppable,
  /// distinct from a category that was natively a flow value (CATEGORY_FLOW_VALUE).
  DESCRIPTOR_EVIDENCE
}

// ── Merchant Intelligence (MI1 M1 — additive, nothing reads/writes yet) ───────

/// Provenance for a transaction's `category` — WHY it is what it is. Written by
/// MI M2's resolution stack (one arm per source), read from M6. `Transaction.categorySource`
/// is nullable with NO default: null = "pre-MI row, provenance unknown" (the MC1
/// Phase 0 doctrine), never a manufactured claim. USER_OVERRIDE is the row-level
/// human correction that dominates all detectors (forms-investigation ratchet).
enum CategorySource {
  PLAID_PFC // provider personal_finance_category (flow-structural primary/detailed)
  USER_RULE // a MerchantRule authored by the user (MerchantRuleScope.USER)
  GLOBAL_CATALOG // the in-code curated global merchant→category catalog (lib/transactions/merchant-rules.ts)
  PFC_SPEND_BUCKET // expanded PFC spend primary mapped to a spend category
  USER_OVERRIDE // explicit per-row human correction (row-level, dominates)
  LEGACY // pre-MI derivation retrofitted by backfill
}

// ── Transaction Intelligence (TI2 — additive; nothing reads/writes yet) ───────
// Durable single-row transaction-fact enums. TI2-1 creates the types only; the
// builder (TI2-3) and writers (TI2-4/5) come in later slices. Values follow the
// ratified TI2/TI2A vocabulary — UNKNOWN is the honesty valve, never a fabricated
// claim. New enum TYPES (not ALTER TYPE ADD VALUE), so this slice is reversible.

/// How the payment was transacted (Plaid `payment_channel`).
enum PaymentChannel {
  ONLINE
  IN_STORE
  OTHER
  UNKNOWN
}

/// Payment instrument. Derived and partial — many rows resolve to UNKNOWN.
/// WALLET/CRYPTO deliberately absent: not derivable from Plaid transaction data.
enum PaymentMethod {
  CARD
  ACH
  WIRE
  CHECK
  CASH
  INTERNAL_TRANSFER
  UNKNOWN
}

/// Settlement lifecycle state. TI2 owns pending/posted only; REVERSED/VOIDED are
/// relational transitions owned by TI4 and deliberately absent here.
enum SettlementState {
  PENDING
  POSTED
}

/// Provider counterparty class (Plaid `counterparties[].type` subset). The
/// "owned account" determination is relational and owned by TI4, not here.
enum CounterpartyType {
  MERCHANT
  FINANCIAL_INSTITUTION
  INCOME_SOURCE
  PAYMENT_APP
  MARKETPLACE
  PAYMENT_TERMINAL
  UNKNOWN
}

// ── Transfer evidence (TE1 — provider-neutral, persisted) ─────────────────────
// Orthogonal axes normalized from provider evidence (e.g. Plaid PFC) by a stage-1
// adapter (lib/transactions/plaid-transfer-evidence.ts) into the canonical contract
// (lib/transactions/transfer-evidence.ts). A single provider signal typically sets
// exactly ONE axis. Provider category strings are NEVER stored in these fields —
// they remain in pfcPrimary/pfcDetailed. Nothing in liquidity/Cash Flow reads these
// yet; TransferDisposition is derived downstream, not persisted.

/// The intermediary RAIL a transfer used — HOW it moved, never why.
enum TransferRail {
  PAYMENT_APP
}

/// The physical/monetary FORM the money took. Only CASH is currently attestable.
enum TransferMovementForm {
  CASH
}

/// The VENUE class associated with the movement (a destination for OUT, an origin
/// for IN — never assumed "reached").
enum TransferVenueClass {
  DEPOSITORY
  BROKERAGE
  EXCHANGE
}

/// Scope at which a MerchantRule applies. USER is the live scope (author's own
/// corrections, M5). SPACE is schema'd but its writer/reader is deferred to its
/// own slice — a shared row cannot hold two Spaces' truths (SpaceAccountLink makes
/// this structural). GLOBAL is deliberately absent: the global catalog stays in code.
enum MerchantRuleScope {
  USER
  SPACE
}

/// Where a MerchantAlias mapping came from. Ambiguity is resolved by refusing the
/// second mapping, not by ranking — this is provenance, not precedence.
enum MerchantAliasSource {
  PLAID
  IMPORT
  USER
}

/// Provider-neutral source of a Merchant's enrichment fields (website/logoUrl/…).
/// PLAID_COUNTERPARTY is the first source (Plaid already sends this on every synced
/// transaction and it is currently discarded). Other providers may later populate
/// the SAME fields through a provider-neutral enrichment adapter — e.g. Coinbase
/// metadata, Schwab/security metadata, or a future external enrichment provider.
/// No provider-specific columns are added for these; only this source stamp changes.
enum MerchantEnrichmentSource {
  PLAID_COUNTERPARTY
  COINBASE
  SECURITY_METADATA
  EXTERNAL_PROVIDER
}

// ─────────────────────────────────────────────────────────────────────────────
// Transaction
// Pulled from Plaid or entered manually. Positive = money in, negative = out.
//
// Transactions anchor solely on financialAccountId (PCS-3B — legacy Account FK
// retired). The data layer exposes it as a single `accountId` DTO field on read.
// ─────────────────────────────────────────────────────────────────────────────

model Transaction {
  id String @id @default(cuid())

  financialAccountId String?
  financialAccount   FinancialAccount? @relation("FinancialAccountTransactions", fields: [financialAccountId], references: [id], onDelete: Cascade)

  date        DateTime            @db.Date
  merchant    String
  description String?
  category    TransactionCategory
  amount      Float
  pending     Boolean             @default(false)

  // ── L8-A — the persisted economic chronology (additive, nullable) ──────────
  //
  // WHEN THE ACTIVITY HAPPENED, as opposed to when the provider posted it.
  // `date` above is UNCHANGED and remains the POSTING date: it is the historical
  // engine's input and its immutability is load-bearing. These answer different
  // questions and both exist.
  //
  // Written by lib/transactions/economic-date-write.ts, which wraps the SAME
  // authority the read path uses (lib/transactions/economic-date.ts). It is a
  // pure function of `date` + `authorizedAt`, so a standing probe can assert
  // stored == derived for every row — and does.
  //
  // ⚠️ NULLABLE, and null means "not yet backfilled", never "same as posting".
  // A NOT NULL column with a `date` default would make an unbackfilled row
  // indistinguishable from a genuinely same-day one, and the backfill could
  // never prove it had finished.
  //
  // ⚠️ Only the DATE is persisted. Basis / state / lagDays stay DERIVED at read
  // time from `date` + `authorizedAt` — storing an explanation beside the value
  // creates two facts that can disagree. This column is the sort key, not the
  // story.
  //
  // Nothing reads it yet: L8-A is dual-write only. The reader cutover
  // (ordering, cursor, filters, counts, grouping, Cash Flow, AI, exports,
  // drawers) is a separate, atomic slice that consumes this column.
  economicDate DateTime? @db.Date

  // ── L8 — the logical economic event this row is the CURRENT projection of ──
  //
  // A pending transaction and its posted successor are two OBSERVATIONS of one
  // event, not two unrelated identities. This is the link from the row users see
  // to that event. Nullable and additive: null = "not yet backfilled" or a row
  // outside the banking domain (crypto has its own implementation later).
  //
  // ⚠️ NOTHING READS THIS YET. L8 establishes identity + dual-write; the reader
  // cutover is a separate slice. A probe enforces that.
  transactionEventId String?
  transactionEvent   TransactionEvent? @relation("EventTransactions", fields: [transactionEventId], references: [id], onDelete: SetNull)
  /// L8-B1 — set when THIS row is its event's current projection. The read
  /// boundary filters on it, so a superseded row can never reach a total.
  currentOfEvent     TransactionEvent? @relation("EventCurrentTransaction")

  plaidTransactionId String? @unique // prevents duplicate inserts on re-sync

  // D2 Step 4D — written by the import pipeline ("externalId" match
  // resolution in app/api/accounts/[id]/import). Generic sibling of plaidTransactionId
  // for files/exports that carry their own stable row id.
  //
  // V26-PRE (B4) — the uniqueness shape deferred at Step 4D is now decided and
  // ENFORCED AT THE DB as a PARTIAL unique index (not representable in this
  // schema; Prisma 5 has no partial-index syntax):
  //
  //   Transaction_account_externalId_active_key
  //     UNIQUE ("financialAccountId", "externalTransactionId")
  //     WHERE "externalTransactionId" IS NOT NULL AND "deletedAt" IS NULL
  //   (migration 20260727_v26pre_b4_btc_identity_backstop)
  //
  // Active rows only — exactly the identity-doctrine invariant (no second
  // ACTIVE row per (account, externalId)); tombstones excluded so import
  // rollback → re-import keeps working. Backstops the lock-free BTC wallet
  // sync (btc-sync.ts createMany now passes skipDuplicates so a concurrent
  // manual-sync/cron overlap no-ops instead of duplicating). DO NOT accept a
  // `migrate dev` drift-drop of this index. See also
  // docs/initiatives/d2/investigations/D2_STEP4B_IMPORTBATCH_FOUNDATION_INVESTIGATION.md §3.
  importBatchId         String?
  importBatch           ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  externalTransactionId String?

  // D2 Step 4D-3 — soft-delete set by import rollback
  // (app/api/imports/[id]/rollback → ImportBatch.status = ROLLED_BACK).
  // See D2_STEP4B_IMPORTBATCH_FOUNDATION_INVESTIGATION.md §1.
  deletedAt DateTime?

  // ── FlowType semantics (v2.5.5 P3 Phase A — additive, nullable) ────────────
  // Persists the deterministic classifier output (lib/transactions/flow-classifier.ts).
  // Phase A only creates these columns; nothing writes or reads them yet
  // (write-time population = Phase B, backfill = P4, read cutover = P5).
  // counterpartyAccountId is the best-effort "other side" of the movement when
  // it is a known owned account — the destination-aware seam that makes
  // per-liability debt attribution (KD-18) deterministic. onDelete: SetNull
  // mirrors importBatchId: deleting the referenced account degrades the pointer
  // to null, never deletes the transaction.
  flowType                 FlowType?
  flowDirection            FlowDirection?
  counterpartyAccountId    String?
  counterpartyAccount      FinancialAccount?         @relation("TransactionCounterpartyAccount", fields: [counterpartyAccountId], references: [id], onDelete: SetNull)
  classificationConfidence Float?
  classificationReason     FlowClassificationReason?
  classifierVersion        Int?
  // Raw Plaid personal_finance_category hints (captured in memory since P2).
  // Kept as String — Plaid owns/versions this taxonomy; it is a provider hint,
  // not Fourth Meridian semantics (which live in flowType).
  pfcPrimary               String?
  pfcDetailed              String?
  pfcConfidenceLevel       String?
  // Forward seed for the Merchant Engine — the stable Plaid merchant key. Lets a
  // future Merchant table + merchantId FK backfill without a Plaid re-fetch.
  merchantEntityId         String?

  // MC1 Phase 0 — currency provenance (additive, nullable). ISO 4217 code of
  // `amount`, from Plaid iso_currency_code at write time, or the parent
  // account's currency for imports/fallback. Null = pre-Phase-0 row whose
  // denomination was never recorded (backfilled from parent account where
  // derivable). Nothing reads this until MC1 Phase 2+.
  currency String?

  // ── Merchant Intelligence (MI1 M1 — additive, nullable; nothing reads/writes) ─
  // Persisted merchant identity + category provenance foundation. Written by
  // MI M2 (categorySource/categoryRuleId) and M4 (merchantId); read from M6.
  // All three are nullable with NO default:
  //   merchantId      — resolved Merchant FK; null = unresolved (pre-M4 rows).
  //   categorySource  — WHY `category` is what it is; null = "pre-MI, provenance
  //                     unknown" (MC1 Phase 0 doctrine), never a manufactured claim.
  //   categoryRuleId  — the MerchantRule that set the category, when a rule did.
  // onDelete: SetNull on both FKs mirrors importBatchId/counterpartyAccountId:
  // deleting a Merchant or MerchantRule degrades the pointer to null, never
  // deletes the transaction.
  merchantId       String?
  resolvedMerchant Merchant?       @relation("MerchantTransactions", fields: [merchantId], references: [id], onDelete: SetNull)
  categorySource   CategorySource?
  categoryRuleId   String?
  categoryRule     MerchantRule?   @relation("MerchantRuleTransactions", fields: [categoryRuleId], references: [id], onDelete: SetNull)

  // ── Transaction Intelligence (TI2 — additive, nullable; nothing reads/writes yet) ─
  // Durable single-row "what actually happened" facts, computed once at write by a
  // future TI2-3 builder and stamped by TI2-4/5 writers; read from TI5. TI2-1 (this
  // slice) creates the columns/enums ONLY — no writer, no reader, no capture.
  // All nullable with NO default: null = "pre-TI2 / not captured", never a
  // manufactured claim (MC1 Phase 0 doctrine, as MI's categorySource).
  //   paymentChannel        — how the payment was transacted (Plaid payment_channel).
  //   paymentMethod         — instrument, honesty-valved to UNKNOWN; partial coverage.
  //   settlementState       — pending/posted only; reversed/voided are TI4.
  //   authorizedAt          — when authorized (Plaid authorized_date); distinct from posted `date`.
  //   counterpartyType      — provider counterparty class; "owned account" is TI4.
  //   fxApplied             — the row's currency differed from its account's currency.
  //   pendingTransactionRef — raw Plaid pending_transaction_id seed for TI4's
  //                           pending→posted reconciliation. SYSTEM: never AI/UI.
  //                           Intentionally UNINDEXED until TI4's reconciler queries it.
  //   tiFactsVersion        — shared backfill-gating version (the classifierVersion pattern).
  paymentChannel        PaymentChannel?
  paymentMethod         PaymentMethod?
  settlementState       SettlementState?
  authorizedAt          DateTime?         @db.Date
  counterpartyType      CounterpartyType?
  fxApplied             Boolean?
  pendingTransactionRef String?
  tiFactsVersion        Int?

  // ── Transfer evidence (TE1 — provider-neutral, persisted; additive, nullable) ─
  // Normalized from provider evidence by a stage-1 adapter into orthogonal axes.
  // Provider category strings (Plaid PFC) are NEVER stored here — they stay in
  // pfcPrimary/pfcDetailed. All nullable with NO default: null = no adapter signal
  // (e.g. a CSV/manual row), never a fabricated axis. Ownership is NOT stored here
  // (it is a relational fact). Liquidity/Cash Flow do not read these; the derived
  // TransferDisposition is computed at read time, never persisted.
  //   transferRail               — the rail used, when attested (payment app).
  //   transferMovementForm       — the money's form, when attested (cash).
  //   transferVenueClass         — the venue class associated with the movement.
  //   transferEvidenceConfidence — confidence in the provider→neutral MAPPING (0..1),
  //                                NOT in transaction purpose / economic meaning.
  //   transferEvidenceReason     — deterministic machine reason for the mapping.
  //   transferEvidenceSource     — emitting adapter id (e.g. "plaid").
  //   transferEvidenceVersion    — adapter/mapping version, for replay detection.
  transferRail               TransferRail?
  transferMovementForm       TransferMovementForm?
  transferVenueClass         TransferVenueClass?
  transferEvidenceConfidence Float?
  transferEvidenceReason     String?
  transferEvidenceSource     String?
  transferEvidenceVersion    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financialAccountId])
  @@index([financialAccountId, date])
  @@index([date])
  @@index([importBatchId])
  // L8-A — the economic chronology's indexes, MIRRORING the two posting indexes
  // the explorer actually uses: `[financialAccountId, date]` backs the
  // account-scoped page (the common case) and `[date]` backs the global ordering.
  // Deliberately only those two: `[flowType, date]` and
  // `[financialAccountId, flowType, date]` have no economic twin until a consumer
  // needs one, and an unused index is write cost for nothing.
  @@index([financialAccountId, economicDate])
  @@index([economicDate])
  @@index([transactionEventId])
  // FlowType rollup indexes (P3 Phase A): per-account/per-liability, global
  // per-flow lenses, and reverse counterparty attribution.
  @@index([financialAccountId, flowType, date])
  @@index([flowType, date])
  @@index([counterpartyAccountId])
  // MI1 M1 — merchant-identity + category-provenance FK indexes (additive).
  @@index([merchantId])
  @@index([categoryRuleId])
}

/// L8 — the lifecycle a LOGICAL EVENT is currently in, derived from its
/// observations and never written directly.
///
/// WITHDRAWN is attested, not invented: a pending observation whose row was
/// tombstoned WITHOUT a posted successor is an authorization the provider took
/// back. Seven such rows exist today. Modelling it as "posted" or deleting it
/// would both be false.
enum TransactionEventLifecycle {
  PENDING
  POSTED
  WITHDRAWN
}

/// L8 — ONE LOGICAL ECONOMIC EVENT.
///
/// The stable identity a pending observation and its posted successor share. Its
/// current state is DERIVED from its observations (see
/// lib/transactions/event-identity.ts); nothing here is authored by hand.
///
/// ⚠️ Scope: BANKING only. Crypto/on-chain rows are deliberately excluded — a
/// wallet transaction has no pending↔posted lifecycle of this shape, and forcing
/// it into this table would model a state no provider attests. Crypto shares the
/// abstraction later through its own domain implementation.
model TransactionEvent {
  id                 String   @id @default(cuid())
  financialAccountId String
  financialAccount   FinancialAccount @relation("AccountTransactionEvents", fields: [financialAccountId], references: [id], onDelete: Cascade)

  /// Derived: the lifecycle its observations currently support.
  lifecycle TransactionEventLifecycle

  /// Derived: WHEN THE ACTIVITY HAPPENED. Immutable across posting — that is the
  /// whole point of the event, and a standing invariant proves it does not move.
  economicDate DateTime @db.Date

  /// Derived: the amount the latest observation reports. A restatement appends a
  /// new observation and moves this; the earlier observation is never rewritten.
  currentAmount Float

  /// The Transaction row that is CURRENTLY the live projection of this event —
  /// the one users see. Unique: an event projects to at most one live row.
  ///
  /// L8-B1 — this gained a RELATION so the read boundary can state "this row is
  /// its event's current projection" as a query rather than as a hope. Without
  /// it, one-row-per-event held only because superseded rows happen to get
  /// tombstoned; the filter now says so, and the FK makes a dangling projection
  /// impossible. Additive: the column and its uniqueness are unchanged.
  currentTransactionId String? @unique
  currentTransaction   Transaction? @relation("EventCurrentTransaction", fields: [currentTransactionId], references: [id], onDelete: SetNull)

  /// L8 Part 7 — observation timestamps. `firstPendingObservedAt` is the seed of
  /// the future economic-date precedence, which this slice deliberately does NOT
  /// apply (changing economicDate again is a separate measured cutover).
  firstObservedAt        DateTime
  lastObservedAt         DateTime
  firstPendingObservedAt DateTime?
  postedObservedAt       DateTime?

  /// Derived: how many observations this event has. 1 for a first-observed-posted
  /// row; 2 for a normal pending→posted chain.
  observationCount Int @default(0)

  observations TransactionObservation[] @relation("EventObservations")
  transactions Transaction[]            @relation("EventTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financialAccountId, economicDate])
  @@index([lifecycle])
}

/// L8 — ONE IMMUTABLE PROVIDER OBSERVATION.
///
/// What a provider said about an event at one moment. Append-only: a restatement
/// adds a row, it never edits one. That immutability is what makes the event's
/// current state re-derivable and a provider's history auditable.
///
/// ⚠️ `observationKey` is the IDEMPOTENCE key. Replaying an identical provider
/// payload produces the same key and writes nothing; a genuine restatement (a
/// changed amount, a new posting date) produces a different key and appends.
model TransactionObservation {
  id      String           @id @default(cuid())
  eventId String
  event   TransactionEvent @relation("EventObservations", fields: [eventId], references: [id], onDelete: Cascade)

  /// The Transaction row this observation was read from / written alongside.
  /// Nullable because an observation outlives the row it came from (a tombstoned
  /// pending row is still a real observation of the event).
  transactionId String?

  financialAccountId String
  provider           ProviderType

  /// The provider's own row id (Plaid `transaction_id`, or an import's external
  /// id). Null where the source supplies none — a manual/seed row.
  providerRowId String?
  /// Plaid `pending_transaction_id` — the provider's OWN statement that this row
  /// succeeds another. Rank 1 in the identity hierarchy.
  providerPendingRef String?

  /// When Fourth Meridian OBSERVED this, not when the provider dated it.
  observedAt DateTime @default(now())
  /// PENDING or POSTED, as the provider reported at this observation.
  lifecycle  SettlementState

  amount       Float
  postingDate  DateTime  @db.Date
  economicDate DateTime  @db.Date
  authorizedAt DateTime? @db.Date

  /// Deterministic digest of the observed facts. See the model note above.
  observationKey String @unique

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([transactionId])
  @@index([providerRowId])
  @@index([financialAccountId, economicDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Merchant Intelligence — persisted identity foundation (MI1 M1)
//
// Additive, schema-only. Nothing reads or writes these tables yet:
//   • write-time resolution      = M4
//   • dictionary/category backfill = M3/M4
//   • corrections (user rules)   = M5 (into TI P2's detail surface)
//   • AI read cutover            = M6
//
// Deployment-global identity (no per-user/per-Space partition on Merchant itself);
// PII-minting is guarded at the *resolver* (M4), never by this schema. There is
// deliberately NO MerchantAsset table, NO blob/binary storage, NO fetch pipeline
// in this initiative — see MI1_M0_RATIFICATION_2026-07-07.md §1.6 and the
// readiness investigation §3.1 / §12.
// ─────────────────────────────────────────────────────────────────────────────

/// One canonical merchant identity. `canonicalKey` is the resolver's exact-match
/// key (no fuzzy/ML clustering, ever, in this initiative); `plaidEntityId` is the
/// one approved provider id (mirrors Transaction.merchantEntityId, the forward seed
/// that lets M4 backfill without a Plaid re-fetch). `defaultCategory` is informational.
///
/// Enrichment fields (all nullable) are a STORAGE SHAPE ONLY in M1 — no writer
/// fills them yet. They are provider-NEUTRAL: Plaid counterparty is the first
/// source (Plaid already sends website/logo_url per transaction and the platform
/// discards it today — M4 will capture it), and other providers (Coinbase,
/// Schwab/security metadata, a future external enrichment provider) may later
/// populate the SAME fields through a provider-neutral enrichment adapter. External
/// logo/favicon fetchers belong to a later enrichment slice AFTER the OPS-4
/// dispatcher exists; do not fetch logos externally, cache binaries, or add blob
/// storage / Brandfetch / Clearbit here.
model Merchant {
  id              String               @id @default(cuid())
  canonicalKey    String               @unique
  displayName     String
  plaidEntityId   String?              @unique
  defaultCategory TransactionCategory?

  // ── Enrichment (nullable; storage shape only in M1 — no capture wiring) ──────
  website              String?
  logoUrl              String?
  enrichmentSource     MerchantEnrichmentSource?
  enrichmentConfidence Float?
  enrichedAt           DateTime?

  aliases      MerchantAlias[]
  rules        MerchantRule[]
  transactions Transaction[]   @relation("MerchantTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Alias memory: a raw descriptor key that resolves to one Merchant. `aliasKey`
/// is globally unique — ambiguity is resolved by REFUSING the second mapping, not
/// by ranking. `sample` keeps one raw example for auditability; `source` records
/// where the mapping came from (provenance, not precedence).
model MerchantAlias {
  id         String              @id @default(cuid())
  aliasKey   String              @unique
  sample     String?
  source     MerchantAliasSource
  merchantId String
  merchant   Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
}

/// A merchant→category rule. `scope` USER is the live scope (M5, the author's own
/// corrections); SPACE is schema'd but its writer/reader is deferred to its own
/// slice. GLOBAL is deliberately absent — the global catalog stays in code
/// (lib/transactions/merchant-rules.ts). `ownerUserId` / `spaceId` are nullable
/// seams populated by the scope's own slice; no FK relation is wired in M1 (no
/// reader/writer exists to justify a cascade posture yet).
model MerchantRule {
  id          String              @id @default(cuid())
  merchantId  String
  merchant    Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category    TransactionCategory
  scope       MerchantRuleScope
  ownerUserId String?
  spaceId     String?

  transactions Transaction[] @relation("MerchantRuleTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([ownerUserId])
  @@index([spaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ImportBatch (D2, Phase 2, Step 4B)
// One row per CSV/Excel/QuickBooks upload. Additive, schema-only — nothing
// reads or writes this table yet; the upload/parse/import pipeline is Step 4D.
// financialAccountId is required: the user always selects an existing target
// account before importing (no fingerprint-based auto-account-creation from
// file contents — see Step 4A §5). createdByUserId is nullable, mirroring
// FinancialAccount.createdByUserId's own D11 precedent, so that onDelete:
// SetNull is valid. connectionId is a forward-compatible seam mirroring
// AccountConnection.connectionId / ProviderAccountIdentity.connectionId —
// nullable, unpopulated until D2's later Adapter/ProviderCatalog work exists;
// ImportBatch does not depend on that work existing.
// See docs/initiatives/d2/investigations/D2_STEP4B_IMPORTBATCH_FOUNDATION_INVESTIGATION.md
// and docs/initiatives/d2/investigations/D2_STEP4A_IMPORT_HISTORY_FOUNDATION_INVESTIGATION.md.
// ─────────────────────────────────────────────────────────────────────────────

enum ImportSource {
  CSV
  EXCEL
  QUICKBOOKS
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  ROLLED_BACK
  FAILED
}

// A7-1 — what an ImportBatch imported. Existing batches are all banking
// transaction imports, kept honestly classified by the TRANSACTIONS default
// (zero backfill). INVESTMENT_HISTORY batches carry imported InvestmentEvent
// rows and/or IMPORTED PositionObservation anchors (A7-4). A batch-level
// discriminator, never per-row. See A7 investigation §3.1/§4.
enum ImportBatchKind {
  TRANSACTIONS
  INVESTMENT_HISTORY
}

model ImportBatch {
  id String @id @default(cuid())

  financialAccountId String
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  connectionId String?
  connection   Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  // D2 Step 4D-5b — which ImportMappingProfile (if any) resolved this
  // batch's columns. Set only on the saved-profile-matched path; null for
  // the explicit-mapping and auto-detect paths. onDelete: SetNull so
  // deleting a profile later never deletes the historical batches that used
  // it. See docs/initiatives/d2/implementation/D2_STEP4D5B_IMPLEMENTATION_PLAN.md §2.
  mappingProfileId String?
  mappingProfile   ImportMappingProfile? @relation(fields: [mappingProfileId], references: [id], onDelete: SetNull)

  source                ImportSource
  // A7-1 — batch classification. Default TRANSACTIONS keeps every existing
  // (banking) batch honestly classified with zero backfill; INVESTMENT_HISTORY
  // is set only by the investment import path (A7-4). See A7 investigation §4.
  kind                  ImportBatchKind   @default(TRANSACTIONS)
  originalFilename      String?
  status                ImportBatchStatus @default(PENDING)
  rowCount              Int               @default(0)
  importedCount         Int               @default(0)
  skippedCount          Int               @default(0)
  // D2 Step 4D-1 — additive counters needed once a real classifier (CSV
  // import) exists. matchedCount: rows that resolved to an already-existing
  // Transaction (no new row written) — distinct from skippedCount, which
  // covers rows skipped for other reasons (e.g. an ambiguous fingerprint
  // match). failedCount: rows that could not be parsed/validated at all. See
  // docs/initiatives/d2/investigations/D2_STEP4D1_CSV_IMPORT_MVP_INVESTIGATION.md §8.
  matchedCount          Int               @default(0)
  failedCount           Int               @default(0)
  errorSummary          Json?
  // D2 Step 4D-5b — snapshot of the actual resolved CsvColumnMap, written on
  // every import regardless of which resolver path produced it (auto-detect,
  // explicit mapping, or saved profile). Exists so a profile that's later
  // edited never retroactively changes what a historical batch is recorded
  // as having used — see D2_ARCHITECTURE_REVIEW_PRE_4D5B.md §2.
  resolvedColumnMapping Json?
  // A7-1 — per-row overrides the user made at preview (force-create, exclude,
  // type remap), keyed by row identity: the batch's audit of human intervention
  // applied at commit. Null = no overrides. No writer yet (A7-4). See §4/§5.5.
  userDecisions         Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  transactions                 Transaction[]
  // A3 — investment events imported in this batch (rollback soft-deletes them).
  investmentEvents             InvestmentEvent[]
  // A7-1 — IMPORTED / USER_ASSERTED position anchors written by this batch
  // (rollback soft-deletes them). Back-relation for PositionObservation.importBatch.
  importedPositionObservations PositionObservation[]

  @@index([financialAccountId])
  @@index([createdByUserId])
  @@index([connectionId])
  @@index([mappingProfileId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// ImportMappingProfile (D2, Phase 2, Step 4D-5b)
// Space-scoped, saved column mapping for recurring import sources (e.g. one
// specific bank's CSV/Excel export shape). `mapping` stores the *resolved*
// CsvColumnMap (lib/imports/csv.ts) — all 8 keys present, each a header
// string or null — produced by a prior successful applyExplicitMapping()
// call, not a caller's raw/partial input. Matching a profile against a new
// upload is a trial-application of that same mapping via
// applyExplicitMapping(), never a comparison of the file's full header set —
// see docs/initiatives/d2/investigations/D2_ARCHITECTURE_REVIEW_PRE_4D5B.md §5/§6 for why a
// header-signature hash was considered and rejected. source/institutionLabel
// are informational/display only, never consulted by the matcher. No CRUD
// route exists for this model yet (4D-5b is auto-use only, over rows seeded
// directly via the database client) — see
// docs/initiatives/d2/implementation/D2_STEP4D5B_IMPLEMENTATION_PLAN.md §7/§8.
// ─────────────────────────────────────────────────────────────────────────────

model ImportMappingProfile {
  id String @id @default(cuid())

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  name             String
  source           ImportSource // informational only — NOT part of the matching key
  institutionLabel String? // informational only, e.g. "Chase"

  mapping Json // resolved CsvColumnMap shape — see module comment above

  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  lastUsedAt DateTime?
  useCount   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importBatches ImportBatch[]

  @@unique([spaceId, name])
  @@index([spaceId])
  @@index([createdByUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SpaceSnapshot (renamed from WorkspaceSnapshot, itself renamed from DailySnapshot)
// Written once per day by the background sync job.
// spaceId replaces userId — snapshots belong to the Space, not the user.
// ─────────────────────────────────────────────────────────────────────────────

/// V26-CAP-1 — an APPEND-ONLY record of what a provider declared it could serve.
///
/// Declared capability only. It is not requested history, not demonstrated
/// returned evidence, not licensed support, and not regenerated snapshot
/// support. A row here changes what Fourth Meridian may ATTEMPT; it proves
/// nothing came back and authorizes no snapshot. Only a successful regeneration
/// may move `SpaceSnapshot.cryptoValuationStatus` to "supported".
///
/// APPEND-ONLY, matching the coverage/audit doctrine (InvestmentEventCoverage,
/// AuditLog): every check writes a row, so widening is attributable to a moment
/// and a configuration rather than inferred from a mutated singleton.
///
/// IDENTITY = (provider, capabilityKey). `capabilityKey` fingerprints the
/// CONFIGURATION that determines capability — never the credential itself — so a
/// replaced key starts a new lineage and cannot accidentally widen the old one.
/// Scope is DEPLOYMENT today because the only crypto price credential is a
/// single deployment environment variable; the column exists so a future
/// per-credential contract can be modelled without a migration of meaning.
///
/// ROLLING vs FIXED is load-bearing. A rolling window's floor moves forward
/// every day, so comparing stored dates would report "narrowed" daily and bury
/// real widenings. `historyDays` is authoritative for ROLLING;
/// `earliestSupportedISO` is authoritative for FIXED and a derived audit
/// snapshot for ROLLING. See lib/prices/provider-capability.core.ts.
model ProviderCapabilityObservation {
  id String @id @default(cuid())

  /// PriceProviderAdapter.source — the same stable provenance identifier stored
  /// on PriceObservation.source. Never a vendor name typed by hand.
  provider String

  /// Non-reversible fingerprint of the capability-determining configuration.
  /// NEVER the credential. Distinguishes lineages across a key replacement.
  capabilityKey String

  /// Identity boundary this declaration applies to. "DEPLOYMENT" today.
  scope String

  /// "ROLLING" | "FIXED" — guarded at write time.
  kind String

  /// Authoritative for ROLLING; null for FIXED.
  historyDays Int?

  /// Authoritative for FIXED; a derived snapshot for ROLLING (audit only).
  earliestSupportedISO String

  /// "CONFIG" | "API" | "DEFAULT" — how the declaration was learned.
  declarationSource String

  /// Comparison against the previous valid observation for this identity:
  /// "first-observation" | "unchanged" | "widened" | "narrowed" | "incomparable".
  comparison String

  /// The observation this was compared against. Null on a first observation.
  previousObservationId String?

  /// Set only on a widening, and only once work has been PLANNED — never a claim
  /// that history became supported. Support still requires regeneration.
  widenedFromISO String?
  widenedToISO   String?

  observedAt DateTime @default(now())

  @@index([provider, capabilityKey, observedAt])
}

model SpaceSnapshot {
  id      String   @id @default(cuid())
  spaceId String
  space   Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date

  // Portfolio breakdown
  stocks Float @default(0) // sum of investment account balances
  crypto Float @default(0) // sum of crypto account balances
  total  Float @default(0) // stocks + crypto

  // Banking breakdown
  cash    Float @default(0) // sum of checking balances
  savings Float @default(0) // sum of savings balances
  debt    Float @default(0) // absolute value of debt balances

  // Derived — pre-computed for fast chart queries
  netWorth    Float @default(0) // stocks + crypto + cash + savings − debt
  totalAssets Float @default(0) // stocks + crypto + cash + savings
  cashOnHand  Float @default(0) // max(cash − expense_buffer, 0) — renamed from cashToPlay (legacy "play cash" language)
  netLiquid   Float @default(0) // cash + savings − debt

  // D2.x Slice 4 — true for reconstructed/backfilled historical rows (cash
  // walked back from transactions; investments/loans/manual assets held flat).
  // Today's live snapshot and every pre-existing row read false. Additive,
  // defaulted → zero migration risk.
  isEstimated Boolean @default(false)

  // MC1 Phase 0 — the currency all ten totals on this row were computed and
  // presented in. NOT NULL DEFAULT "USD": unlike row-level stamps this is a
  // property of the computation, and every historical row was computed by
  // USD-presenting code, so the default is a true statement about old rows.
  reportingCurrency String @default("USD")

  // Wealth-timeline amendment system (Phase 2) — points at the most recent
  // deliberate, consent-gated amendment that revised this row. Nullable/SetNull:
  // additive, zero migration risk; every existing row reads null (never amended).
  // An amended row also flips isEstimated→true (a deliberately revised
  // observation is honestly a reconstruction again). See
  // docs/initiatives/wealth-timeline/WEALTH_TIMELINE_AMENDMENT_SYSTEM_PROPOSAL.md §4.
  amendedByAmendmentId String?
  amendedByAmendment   SnapshotAmendment? @relation(fields: [amendedByAmendmentId], references: [id], onDelete: SetNull)

  // ── V26-INVESTMENTS-HISTORY — how this row was computed ────────────────────
  //
  // `isEstimated` is `tier !== "observed"` (regenerate-history.core.ts): a
  // five-value ordinal collapsed into one bit. It cannot separate a day worth
  // $5,056 with every holding valued from a day worth $11.65 with 18 of 19
  // holdings unaccounted for — both persist `true` and render identically.
  //
  // These three scalars are PROPERTIES OF THE COMPUTATION, exactly like
  // `reportingCurrency` above — not financial totals, and not a Completeness
  // ENVELOPE. `reason`, `conflict`, `byComponent` and per-instrument exclusion
  // lists deliberately stay runtime-only, per the ratified anti-`FinancialState`
  // ruling (lib/perspective-engine/types.ts). What is persisted is only what a
  // read path must filter or compare on.
  //
  // All three nullable, no default: additive, zero migration risk. Null means
  // NOT RECORDED, never "zero". Existing rows read null and behave exactly as
  // before. See lib/snapshots/snapshot-completeness.core.ts for the ONE
  // canonical interpretation — consumers must not combine these with
  // `isEstimated` themselves.
  //
  // FROZEN-ROW INVARIANT: an `isEstimated=false` row is an immutable
  // observation and is never rewritten, so its tier stays null forever. That
  // costs nothing: `isEstimated = tier !== "observed"` makes
  // `isEstimated=false ⇒ tier="observed"` a sound inference. The one class of
  // row that can never be enriched is the one class that needs no column.

  // Canonical `CompletenessTier` string ("observed" | "derived" | "estimated" |
  // "incomplete" | "unknown"), guarded at write time by `isCompletenessTier` —
  // the same reserved-String pattern as `PositionObservation.completeness` and
  // `PositionReconstruction.completeness`. Never a parallel vocabulary.
  completenessTier String?

  // Components of the day's INVESTMENT valuation that actually contributed to
  // the stored `stocks` figure, and how many the valuation considered in total.
  // The pair is the composition signal a single tier cannot carry: across the
  // 2026-06-24 → 06-25 seam the tier is `unknown` on BOTH sides while the
  // contributing count moves 1 → 7 of 19. Written only when the day had a real
  // A8 valuation; null when investments were held flat (nothing was composed).
  contributingComponentCount Int?
  totalComponentCount        Int?

  // ── V26-CRYPTO-STATUS-1 — may the stored `crypto` number be ASSERTED? ──────
  //
  // This scalar AUTHORIZES the persisted `crypto` component above. It does not
  // replace it, restate it, or hold a second copy of it — the number stays
  // exactly where it is; this says whether anything may claim it as a value.
  //
  // Needed because `crypto` is NOT NULL DEFAULT 0 and so cannot express
  // "unknown", while writing 0 would assert an absence no evidence supports.
  // Measured on this database: 378 estimated rows carry a crypto figure that is
  // the wallet's then-current USD balance carried backward by an old backfill —
  // 41.7%–99.9% of each row's `totalAssets`.
  //
  // PERSISTED rather than derived, on purpose. The only runtime discriminator is
  // the price archive's floor, and the floor MOVES: acquiring earlier prices
  // does not rewrite snapshots, so a derived test would silently re-bless every
  // stale row the moment a wider tier was configured. A stamped status records
  // what THIS row's valuation actually was, so widening is safe by construction
  // — nothing changes until a regeneration re-derives the day, and that
  // regeneration is what stamps `supported`.
  //
  // Reserved-String, guarded at write time by `isCryptoValuationStatus` — the
  // same pattern as `completenessTier` above. Stored values: "supported" |
  // "unavailable". Nullable, no default: additive, zero migration risk. Null
  // means NOT RECORDED and is NOT automatically trusted when the row carries
  // material crypto (it resolves to `legacy-unrecorded`).
  //
  // FROZEN-ROW INVARIANT: an `isEstimated=false` row is an immutable observation
  // and is never rewritten, so its status stays null forever — and costs
  // nothing, because observation is resolved BEFORE status and is trusted
  // unconditionally. This is what keeps a date-based rule from ever invalidating
  // another user's genuine observed history.
  //
  // See lib/snapshots/crypto-valuation-status.core.ts for the ONE canonical
  // interpretation; consumers must not combine this with `crypto`/`isEstimated`
  // themselves.
  cryptoValuationStatus String?

  createdAt DateTime @default(now())

  @@unique([spaceId, date])
  @@index([spaceId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// AiAdvice
// One record per advice engine run. Belongs to a Space and is attributed
// to the Space's AiAgent. userId removed — advice is Space-scoped.
// ─────────────────────────────────────────────────────────────────────────────

model AiAdvice {
  id          String    @id @default(cuid())
  spaceId     String
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  agentId     String
  agent       AiAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  summary     String
  adviceText  String    @db.Text
  riskLevel   RiskLevel
  actionReady Boolean   @default(false) // renamed from playReady (legacy "play cash" language)
  generatedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([spaceId, generatedAt])
  @@index([agentId, generatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// CreditScore
// Replaces User.ficoScore. Time-series: each manual or API update is a new
// row. source records where the score came from (app, bureau, manual).
// ─────────────────────────────────────────────────────────────────────────────

model CreditScore {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score      Int // 300–850
  source     String   @default("manual") // "manual" | "chase_app" | "amex_app" | "experian"
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, recordedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AuditLog
// Append-only log of security-relevant events. NEVER cascade-deleted when a
// user or Space is removed — userId and spaceId are SET NULL instead.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id                 String   @id @default(cuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  spaceId            String?
  space              Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  action             String // See AuditAction constants in lib/audit-actions.ts
  metadata           Json? // e.g. { institution: "Chase", accountCount: 3 }
  ipAddress          String?
  userAgent          String?
  performedByAdminId String? // set when a SYSTEM_ADMIN performs an action on behalf of another user
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
  @@index([spaceId, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// BetaAccessRequest  (Wave 1 S3 — beta-access request → approval → invite)
//
// Pre-registration access requests have no other home: `User` can't hold a
// pre-account email (registration creates Space/agent/audit atomically), and
// `SpaceInvite` requires an existing invitedUserId FK. So the invite token lives
// as columns HERE (recipient has no User row yet) — the password-reset column
// pattern verbatim: SHA-256-hashed at rest, single outstanding token, expiring,
// nulled on redemption (User.passwordResetToken/Expiry, lines 343-344).
//
// Redemption invariant (register route, inside the existing $transaction):
// status → REDEEMED, redeemedAt/redeemedUserId set, inviteTokenHash nulled —
// single-use exactly like reset-password/route.ts.
// ─────────────────────────────────────────────────────────────────────────────

enum BetaAccessRequestStatus {
  PENDING
  APPROVED // invite minted + emailed
  DENIED
  REDEEMED // invite consumed by a successful registration
}

model BetaAccessRequest {
  id          String                  @id @default(cuid())
  email       String                  @unique // one live request per address
  note        String? // applicant's "why" answer, if the public form asks one
  status      BetaAccessRequestStatus @default(PENDING)
  createdAt   DateTime                @default(now())
  decidedAt   DateTime?
  decidedById String? // soft ref (no FK); mirrors MerchantRule.ownerUserId

  // Invite token — hashed at rest, single outstanding, expiring, nulled on redeem.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime? // when the invite email was (last) sent — resend updates this
  redeemedAt      DateTime?
  redeemedUserId  String? // soft ref to the User created from this invite

  @@index([status, createdAt]) // the queue view
}

// ─────────────────────────────────────────────────────────────────────────────
// ApiUsageCounter  (Wave 2 S7 — Platform Ops API usage/cost visibility)
//
// Durable daily aggregate counters for external-provider API consumption. NOT
// AuditLog (usage is system-level, high-frequency, and aggregated — the wrong
// read shape and would pollute the security feed) and NOT RateLimit (short
// short-window, swept). One row per (provider, metric, unit, day); the atomic
// upsert-increment idiom is the one already proven in lib/rate-limit.ts.
//
// provider/metric/unit are STRINGS, not enums — house style for extensible
// vocabularies (cf. JobRun.status). Dollar cost is deliberately NOT here:
// per-unit prices are contract-specific code/env constants (lib/usage/pricing.ts),
// not schema.
// ─────────────────────────────────────────────────────────────────────────────

model ApiUsageCounter {
  id       String   @id @default(cuid())
  provider String // "PLAID" | "OPENAI"
  metric   String // Plaid: method name ("transactionsSync"); OpenAI: "chat.completions:<model>"
  unit     String // "calls" | "prompt_tokens" | "completion_tokens"
  day      DateTime // UTC date bucket (00:00:00)
  count    BigInt   @default(0)

  @@unique([provider, metric, unit, day])
  @@index([provider, day])
}

// ─────────────────────────────────────────────────────────────────────────────
// RecoveryCode
// One-time backup codes generated when a user enables or regenerates 2FA.
// Codes are shown once in plaintext, then stored as bcrypt hashes.
// Each code can be used once — usedAt is set on redemption.
// Regenerating codes invalidates all existing unused codes.
// ─────────────────────────────────────────────────────────────────────────────

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // bcrypt hash (cost 10) of the plaintext code — NEVER stored as plaintext
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([userId])
  @@index([userId, usedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// UserSession
// Tracks active sessions for session management UI and admin revocation.
// Written on login. revokedAt is set when a session is force-terminated.
// Note: JWT sessions cannot be invalidated mid-token-lifetime without a
// blocklist or short-lived tokens. This table is informational for now;
// full revocation requires a token blocklist (see security limitations).
// ─────────────────────────────────────────────────────────────────────────────

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String    @unique // random opaque identifier (not the JWT itself)
  ipAddress    String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String? // admin userId who revoked this session
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([userId, revokedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformSetting
// Key-value store for platform-wide security and feature toggles.
// Managed exclusively by SYSTEM_ADMIN via /admin/security.
// Keys are defined as constants in lib/platform-settings.ts.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformSetting {
  key         String   @id // e.g. "require_totp_system_admin"
  value       String // "true" | "false" | numeric string
  updatedAt   DateTime @updatedAt
  updatedById String? // userId of last admin who changed this setting
}

// ─────────────────────────────────────────────────────────────────────────────
// RateLimit  (KD-3)
// Fixed-window request counter for endpoint-local rate limiting.
// One row per (key, windowStart) bucket; count is incremented per request.
// `key` encodes scope + endpoint + subject, e.g. "ip:pre-login:1.2.3.4" or
// "user:ai-chat:<userId>". Used only when RATE_LIMIT_ENABLED=true in
// production; local dev uses an in-memory backend (see lib/rate-limit.ts).
// Expired buckets can be swept lazily or via a future cron — additive only.
// ─────────────────────────────────────────────────────────────────────────────
model RateLimit {
  id          String   @id @default(cuid())
  key         String // scope:endpoint:subject
  windowStart DateTime // start of the fixed-window bucket
  count       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([key, windowStart])
  @@index([windowStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// D2.x — Financial Data Integrity Gate (M1). Durable, queryable record of
// transaction-sync integrity issues so silent loss becomes visible and future
// Ambient Intelligence can reason over sync health. Forensic side-table — no
// other model references it; best-effort writes never affect sync results.
// ─────────────────────────────────────────────────────────────────────────────
/// OPS-2D-5A-1 — SyncIssue is now the INCIDENT EPISODE, not one failure event.
///
/// Before this slice every failure inserted an unrelated row, so a bank that
/// failed on 40 transactions produced 40 "issues" and recurrence after recovery
/// was indistinguishable from a first occurrence. The row is now the episode and
/// SyncIssueOccurrence holds each manifestation.
///
/// WHAT IS PERSISTED HERE AND WHAT IS NOT: domain, severity, nature and the
/// active/recovered/evidence/superseded/orphaned state stay DERIVED by
/// lib/platform/sync-issue-semantics.ts and are deliberately not columns — a
/// stored severity drifts from the rule that produced it. Only facts that cannot
/// be reconstructed later (identity, timestamps, relations) are stored. Identity
/// is a database constraint; severity is a current opinion.
model SyncIssue {
  id                 String        @id @default(cuid())
  provider           String        @default("PLAID")
  plaidItemId        String?
  financialAccountId String?
  kind               SyncIssueKind
  plaidTransactionId String?
  plaidAccountId     String?
  detail             Json? // { merchant, amount, date, balanceDelta, txnSum, threshold, ids, ... }
  /// COMPATIBILITY PROJECTION, not the lifecycle authority. Kept in this slice
  /// because lib/platform/sync-issue-semantics.ts and six consumers read it;
  /// the lifecycle service writes it in lockstep with resolvedAt so the two can
  /// never disagree. Removal is a later slice, once every read is migrated.
  resolved           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // ── Incident identity (OPS-2D-5A-1) ────────────────────────────────────────
  /// Canonical semantic identity, built ONLY by lib/platform/incidents/identity.ts.
  /// Null on legacy rows written before this slice — they are readable but were
  /// never episodes, and no identity is invented for them.
  incidentKey        String?
  /// Bumped when the identity RULE changes, so a future taxonomy split can
  /// re-key without silently merging episodes built under the old rule.
  incidentKeyVersion Int?
  /// Episode chain: the resolved episode this one recurred from. Null on a first
  /// episode. Recurrence NEVER reopens a resolved row.
  previousIncidentId String?

  // ── Lifecycle (OPS-2D-5A-1) ────────────────────────────────────────────────
  firstOccurredAt      DateTime?
  lastOccurredAt       DateTime?
  resolvedAt           DateTime?
  /// AUTOMATIC_RECOVERY is the only kind any current code path can produce.
  resolutionKind       String?
  /// RefreshExecution.id of the run that proved recovery. Soft reference (the
  /// ledger is append-only and must survive item deletion), null when the
  /// resolving path had no execution — never fabricated.
  resolvingExecutionId String?

  occurrences SyncIssueOccurrence[]

  @@index([financialAccountId, resolved])
  @@index([plaidItemId, kind])
  @@index([incidentKey])
  @@index([resolvedAt])
}

/// OPS-2D-5A-1 — one observed manifestation of an incident episode.
///
/// This is where execution correlation becomes real. Before, the only link was
/// `SyncIssue.detail.runId` — an untyped JSON value that is sometimes a genuine
/// RefreshExecution.runId and sometimes a UUID minted locally by
/// syncTransactionsForItem when no caller threaded one (exchangeToken still does
/// this). It could not be joined, indexed, or trusted.
model SyncIssueOccurrence {
  id                 String    @id @default(cuid())
  syncIssueId        String
  syncIssue          SyncIssue @relation(fields: [syncIssueId], references: [id], onDelete: Cascade)
  /// RefreshExecution.id, resolved by LOOKING UP the runId — stored only when a
  /// matching execution actually exists. Null is honest and common: several
  /// producers have no envelope at all. Soft reference for the same reason as
  /// resolvingExecutionId.
  refreshExecutionId String?
  /// The run correlator as the producer knew it. Retained for diagnostics and
  /// for legacy comparison; it is NOT the relationship authority.
  runId              String?
  observedAt         DateTime  @default(now())
  /// Per-occurrence technical evidence. The episode keeps the first detail; this
  /// keeps every one, so a 40-failure page is 40 occurrences, not 40 incidents.
  detail             Json?

  @@index([syncIssueId, observedAt])
  @@index([refreshExecutionId])
}

enum SyncIssueKind {
  MISSING_ACCOUNT
  UPSERT_ERROR
  REMOVED_TOMBSTONE
  BALANCE_TX_MISMATCH
  REPLAY_ATTEMPTED // reserved for v2.5 auto-recovery
  REPLAY_RECOVERED
  REPLAY_FAILED
  INSTRUMENT_IDENTITY_CONFLICT // A1 — refused Instrument merge (conflicting strong ids / alias)

  // OPS-2D-5B-1 — typed persistence taxonomy. UPSERT_ERROR spanned ten distinct
  // operations; these four split it by OPERATOR REMEDIATION, not by file or by
  // Prisma call. The fine-grained operational detail stays in the incident's
  // operationKey, so these are descriptions, never identity.
  //
  // UPSERT_ERROR is retained: legacy rows keep their recorded kind, and nothing
  // rewrites history to match a newer vocabulary.
  TRANSACTION_PERSISTENCE_FAILED // bank transaction not persisted; cursor held
  INVESTMENT_DATA_PERSISTENCE_FAILED // holdings/events/opening-position repair failed
  IMPORT_ROLLBACK_FAILED // a user import rollback did not complete
  WALLET_SYNC_FAILED // on-chain wallet discovery/balance/price failed
}

// ─────────────────────────────────────────────────────────────────────────────
// FxRate (MC1 Phase 1) — immutable dated FX rate archive.
// Rows for closed dates are never updated or deleted (append-only, enforced at
// the application layer: insert-only writes for dates ≤ yesterday UTC). This
// immutability is what makes read-time conversion (MC1 Phase 2) deterministic
// and history-stable: resolving a past-dated rate returns the same answer
// forever. Standalone archive — no other model references it; nothing consumes
// it until MC1 Phase 2. See docs/initiatives/mc1/MC1_PHASE1_FX_PROVIDER_LAYER_PLAN.md.
// ─────────────────────────────────────────────────────────────────────────────
model FxRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date // valuation date, daily close granularity (plan D4)
  base      String // canonical base — always "USD" (lib/fx/config.ts, Slice 2)
  quote     String // ISO 4217
  rate      Float // 1 base = rate quote (Float confirmed — plan D3)
  source    String // adapter that supplied the batch — provenance
  fetchedAt DateTime @default(now())

  // Determinism anchor: ONE canonical rate per (date, pair) — deliberately not
  // per source; which provider supplied it is provenance (`source`), not identity.
  @@unique([date, base, quote])
  // Walk-back scans (base is constant USD): latest date ≤ asked, per quote.
  @@index([quote, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification (OPS-3 S1) — the per-recipient, user-facing awareness record.
// Frozen design: docs/initiatives/ops3/OPS3_IMPLEMENTATION_PLAN.md §2.
//
// The Notification row IS the in-app delivery (no NotificationDelivery row is
// written for the IN_APP channel — deliveries exist only for external
// channels). Lifecycle is nullable timestamps, never a status enum:
// unread (readAt null) → read → archived; expiresAt hides at any stage.
//
// category/type are strings validated by lib/notifications/registry.ts (the
// AuditAction idiom — adding a type must never require a migration). ALL
// writes go through lib/notifications/create.ts, the single chokepoint.
//
// auditLogId is a SOFT ref (no FK — AuditLog is append-only forensics with
// SetNull anonymization; the two objects have different retention and PII
// posture). dedupeKey is condition identity (suppress-while-open); the unique
// constraint is reserved at birth because retrofitting it onto a populated
// table would require a dedupe backfill. There is deliberately NO
// sourceEventId column (frozen ruling — OPS3_SOURCEEVENTID_OWNERSHIP_REVIEW).
//
// TRUST BOUNDARY (F14): Platform Operations / OPS-5 reads AGGREGATES and
// delivery METADATA over these tables — never title/body, which are
// tenant-scoped product content.
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationPriority {
  LOW // digest-foldable, no badge urgency
  NORMAL // default
  HIGH // sync failed, goal risk
  CRITICAL // security / account lifecycle — locked category, cannot be muted
}

model Notification {
  id      String  @id @default(cuid())
  userId  String // recipient — always a single user; the inbox dies with the account
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId String? // optional Space context
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  category String // NotificationCategory — registry-validated string, never a DB enum
  type     String // registry id, PO1 P0 grammar (e.g. "SPACE_INVITE_RECEIVED")
  priority NotificationPriority @default(NORMAL)

  title      String
  body       String? @db.Text
  href       String? // in-app destination
  metadata   Json? // shape per the type's registry pointer contract (F6)
  auditLogId String? // soft ref to the AuditLog fact — no FK by design (F5)
  dedupeKey  String? // condition identity, template owned by the registry entry (F3)

  readAt     DateTime? // null = unread
  archivedAt DateTime? // null = live in the feed (dismiss == archive)
  expiresAt  DateTime? // null = never expires; past = hidden from all queries
  createdAt  DateTime  @default(now())

  deliveries NotificationDelivery[]

  // Dedupe constraint reserved at birth (Postgres treats NULLs as distinct,
  // so keyless rows — the majority — are unconstrained).
  @@unique([userId, dedupeKey])
  @@index([userId, archivedAt, createdAt]) // feed + history
  @@index([userId, readAt]) // unread badge count
  @@index([category, createdAt]) // OPS-5 aggregate queries
}

// ─────────────────────────────────────────────────────────────────────────────
// NotificationDelivery (OPS-3 S1) — one row per EXTERNAL-channel delivery
// attempt (EMAIL in S4; PUSH/SMS/WEBHOOK are vocabulary). status mirrors the
// OPS-1 EmailResult contract verbatim. Append-only in spirit: attempts
// progress, history is never rewritten — this is the raw substrate for OPS-4
// retries and OPS-5 provider-health rollups.
//
// NO WRITER EXISTS in S1 by design: the table ships with the one OPS-3
// migration; the S4 email adapter is its first writer. openedAt/clickedAt
// arrive with the future Resend-webhook consumer (frozen ruling F10 —
// columns are deferred until a writer exists).
// ─────────────────────────────────────────────────────────────────────────────

model NotificationDelivery {
  id                String       @id @default(cuid())
  notificationId    String
  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel           String // "EMAIL" now; others are vocabulary — string, not enum
  status            String // "sent" | "captured" | "skipped" | "error" — EmailResult verbatim
  provider          String? // e.g. "resend" | "capture"
  providerMessageId String?
  error             String?
  attempts          Int          @default(1)
  deliveredAt       DateTime? // set when status = "sent"
  createdAt         DateTime     @default(now())

  @@index([notificationId])
  @@index([channel, status, createdAt]) // OPS-5 failure-rate queries
}

// ─────────────────────────────────────────────────────────────────────────────
// NotificationPreference (OPS-3 S3) — category × channel preference OVERRIDES.
// DEFAULT-BY-ABSENCE (frozen F11): a row exists only when the user deviates
// from the registry default (lib/notifications/registry.ts). Resolution order,
// enforced in lib/notifications/preferences.ts:
//   locked category → forced on · override row → row wins · else registry default.
// ACCOUNT_SECURITY is locked — the API rejects writes for it, so no row for
// that category can ever exist. category/channel are registry-validated
// strings, never DB enums (adding a category must not require a migration).
// ─────────────────────────────────────────────────────────────────────────────

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String // NotificationCategory constant
  channel   String // "IN_APP" | "EMAIL" (PUSH/SMS/WEBHOOK are vocabulary)
  enabled   Boolean
  updatedAt DateTime @updatedAt

  @@unique([userId, category, channel])
}

// ─────────────────────────────────────────────────────────────────────────────
// JobRun (OPS-4 S1) — the background-job execution ledger. Append-only dated
// fact table (the AuditLog / FxRate / SyncIssue idiom): one row per scheduled
// unit of work, written ONLY by lib/jobs/run.ts's runJob() wrapper.
// Frozen design: docs/initiatives/ops4/OPS4_BACKGROUND_JOBS_INVESTIGATION_
// 2026-07-07.md §6 S1 + docs/initiatives/ops4/OPS4_S0_RULINGS.md.
//
// APPEND-ONLY SEMANTICS: a row is created when a run starts (status
// "running") and receives exactly ONE completion write (status/completedAt/
// durationMs/summary/errorSummary). No update after completion, ever; no
// deletes (retention policy deferred by ruling R2 — arrives with the S3
// sweep, not before).
//
// TRUST BOUNDARY (inherits OPS-3 F14 / PO1 telemetry doctrine): summary
// carries counts, kinds, dates, and IDs ONLY — never user content, merchant
// strings, or monetary values. A summary field containing user content is a
// KD-1-class defect. This table is a fact ledger, NOT a metrics/telemetry
// system: counters and rollups belong to PO1 Phases 1/3 (ruling R8).
//
// jobName/trigger/status are strings, never DB enums (the registry idiom —
// adding a job must not require a migration).
// ─────────────────────────────────────────────────────────────────────────────

model JobRun {
  id            String    @id @default(cuid())
  jobName       String // e.g. "sync-banks" | "fetch-fx-rates" | "process-deletions"
  trigger       String // "cron" now; "manual" | "script" are vocabulary
  executionId   String    @unique // wrapper-generated UUID; correlates console logs to this row
  status        String // "running" | "succeeded" | "failed"
  startedAt     DateTime
  completedAt   DateTime? // set by the single completion write
  durationMs    Int? // wall-clock, set at completion
  summary       Json? // counts/kinds/IDs only — never user content or monetary values
  errorSummary  String? // truncated message only (no stack), set when status = "failed"
  // OPS-2B′ — the deployment that PRODUCED this fact. See RefreshExecution's
  // fuller note below; identical semantics, identical resolver, stamped once at
  // the start write and never touched by the completion write.
  deploymentSha String?
  createdAt     DateTime  @default(now())

  @@index([jobName, startedAt]) // "did last night's X run?"
  @@index([status, startedAt]) // failure scans
  @@index([deploymentSha]) // "which runs belong to deployment X"
}

// ─────────────────────────────────────────────────────────────────────────────
// RefreshExecution / RefreshEndpointResult  (DF-2A — Canonical Refresh
// Execution Authority)
//
// The per-ITEM refresh execution ledger. JobRun (above) records one row per
// scheduled BATCH (the nightly sync-banks run); it cannot answer "for THIS
// connection's refresh, what was attempted, what succeeded, what failed, what
// changed, and how long did it take?" — the manual per-item Refresh, the
// webhook, and the reconnect syncs write no JobRun at all. This pair captures
// that per-item grain: one immutable RefreshExecution per refresh invocation,
// one immutable RefreshEndpointResult per stage it attempted.
//
// IMMUTABILITY (the runJob idiom): written through ONE chokepoint
// (lib/plaid/refresh-execution.ts). A start row is created "RUNNING"; exactly
// ONE completion write sets completedAt/durationMs/overallStatus/errorSummary.
// Historical facts are NEVER rewritten to reflect later freshness, pricing, or
// connection state — corrections belong in a LATER execution, not a mutation.
// Ledger writes are best-effort/non-throwing: a telemetry failure must never
// turn a successful provider refresh into a customer-visible provider failure.
//
// STRINGS, NOT DB ENUMS (the JobRun idiom): trigger/profile/overallStatus and
// the child endpoint/status/skipReason are Strings, with TypeScript
// string-union types in lib/plaid/refresh-execution-types.ts — adding a trigger
// (WEBHOOK), a profile, or a stage (LIABILITIES) must not require a migration.
//
// SOFT REFERENCES, NO FKs (the JobRun/SyncIssue idiom): plaidItemId and
// parentJobRunId are plain indexed Strings, so the ledger SURVIVES deletion of
// the item or batch it observed — historical evidence is never cascade-deleted.
//
// FACTS, NOT POLICY: counts, timing, covered accounts. No dollar cost, tier, or
// user-facing freshness label — those are downstream derivations (DF-2D+).
// ─────────────────────────────────────────────────────────────────────────────

model RefreshExecution {
  id              String    @id @default(cuid())
  runId           String    @unique // first-class run correlator; stamped into SyncIssue.detail.runId and (later) provider-usage rows
  plaidItemId     String // soft reference (no FK) — ledger survives item deletion
  trigger         String // "MANUAL" | "CRON" | "RECONNECT" | "WEBHOOK" | "ADMIN"
  profile         String // "FULL_REFRESH" | "RECONNECT"
  startedAt       DateTime
  completedAt     DateTime? // set by the single completion write
  durationMs      Int? // wall-clock, set at completion
  overallStatus   String // "RUNNING" | "SUCCEEDED" | "PARTIAL" | "FAILED" | "SKIPPED" — derived from child results
  parentJobRunId  String? // soft ref to JobRun.id when this refresh ran under a batch (cron); null for standalone manual
  errorSummary    String? // truncated message only (no stack), set when overallStatus != SUCCEEDED
  // ───────────────────────────────────────────────────────────────────────────
  // OPS-2B′ — DEPLOYMENT IDENTITY. The deployment that PRODUCED this fact, not
  // the current/latest/active one: a historical row keeps its original identity
  // forever, exactly like every other value in this ledger.
  //
  // Stamped ONCE at the start write from lib/monitoring/deployment.ts
  // (`currentDeploymentSha()`) — the same value Sentry uses as its `release`, so
  // an incident and the execution that produced it share one key. The completion
  // write NEVER touches this column.
  //
  // NULLABLE AND PERMANENTLY SO. Null means "the deployment was not observable
  // when this fact was written" (local dev, self-hosted, pre-OPS-2B′ history).
  // It is never backfilled, never inferred, never defaulted to a placeholder —
  // an unknown deployment must not become a confident wrong one. Every consumer
  // must tolerate null.
  //
  // A PLAIN STRING, NOT A `Deployment` TABLE. A deployment entity would need a
  // lifecycle this system does not own or observe (when a deploy began, ended,
  // was rolled back), and an FK would couple immutable history to a table that
  // could be pruned — the exact cascade hazard the soft-reference rule exists to
  // avoid. The sha identifies the CODE; it is deliberately not unique per deploy
  // (a redeploy or preview→prod promotion repeats it). Instance-grain, if ever
  // needed, is an ADDITIVE column, not a redesign of this one.
  // ───────────────────────────────────────────────────────────────────────────
  deploymentSha   String?
  // ───────────────────────────────────────────────────────────────────────────
  // OPS-2D-3 — ADMISSION EVIDENCE. Set only when this execution was DENIED by
  // the canonical admission evaluator (lib/platform/admission): the typed reason
  // code from ADMISSION_REASONS, never free text. Null on every execution that
  // was admitted — which is every execution written before this slice, and the
  // overwhelming majority after it.
  //
  // A denied execution is RECORDED, not silent. A pause that produces no
  // evidence would make the operator's own declaration invisible on the very
  // surfaces built to observe it, and would leave "nothing ran" and "we chose
  // not to run" indistinguishable in the ledger — the absence-is-a-state failure
  // this project guards against everywhere else.
  //
  // Deliberately NOT errorSummary: a policy decision is not an error, and
  // folding it into the error column would make every operator-declared pause
  // read as a failure on the Refresh workspace.
  // ───────────────────────────────────────────────────────────────────────────
  admissionReason String?
  createdAt       DateTime  @default(now())

  endpoints       RefreshEndpointResult[]
  providerCalls   ProviderCall[]
  accountCoverage RefreshEndpointAccountCoverage[]

  @@index([plaidItemId, startedAt]) // "recent refreshes of this connection"
  @@index([overallStatus, startedAt]) // failure / partial scans
  @@index([parentJobRunId]) // executions under a batch
  @@index([deploymentSha, startedAt]) // "which refreshes belong to deployment X", newest first
}

// ─────────────────────────────────────────────────────────────────────────────
// RefreshEndpointAccountCoverage  (DF-2E — per-account coverage & execution
// freshness authority)
//
// One row per (execution, endpoint, FinancialAccount) the execution EVALUATED.
// This is the canonical answer to: which accounts did a refresh actually
// process, which endpoint touched each, which were intentionally skipped (and
// why), whether their freshness advanced, and — by reverse lookup — which
// execution most recently refreshed a given account. Consumed later by OPS-2;
// it owns NO UI.
//
// COVERAGE ≠ SUCCESS/DATA/HEALTH (see REFRESH_COVERAGE_DOCTRINE.md):
//   status COVERED  = this execution freshly evaluated (and wrote/observed) the
//                     account for this endpoint. `freshnessAdvanced` records
//                     whether a fresh observation actually landed (a successful
//                     empty/no-change response STILL advances freshness).
//   status SKIPPED  = the account was present but intentionally NOT evaluated
//                     (reason: ACCOUNT_DISCONNECTED, NO_HOLDINGS, NOT_APPLICABLE)
//                     — distinct from an account whose stage FAILED (no row here
//                     + a FAILED RefreshEndpointResult).
//   status FAILED   = reserved for a per-account provider/processing failure;
//                     whole-stage provider failures produce NO per-account row
//                     (the accounts were never iterated) — that reason lives on
//                     the endpoint result, not here. (Not produced yet.)
//
// EXECUTION freshness, NOT observed freshness: `freshnessAdvanced` states that
// THIS execution advanced the account's freshness for this endpoint. Current
// "is the data stale now" (observed freshness) stays in resource-freshness.ts;
// provider-side timestamps stay on FinancialAccount.balanceLastUpdatedAt. UNKNOWN
// freshness is never asserted as "now" — absence of a COVERED row means the
// account was not freshly observed, never that it is fresh.
//
// SOFT account reference (no FK to FinancialAccount): a point-in-time historical
// fact; a later account merge/deletion/identity-correction must not rewrite or
// cascade-erase it. FK-cascade to RefreshExecution only (its own ledger root).
// Immutable: one row per (execution, endpoint, account), never updated.
// ─────────────────────────────────────────────────────────────────────────────

model RefreshEndpointAccountCoverage {
  id                 String           @id @default(cuid())
  refreshExecutionId String
  execution          RefreshExecution @relation(fields: [refreshExecutionId], references: [id], onDelete: Cascade)
  endpoint           String // the stage that evaluated the account ("BALANCES" | "HOLDINGS" | ...)
  financialAccountId String // SOFT reference (no FK) — survives account merge/deletion/identity-correction
  status             String // "COVERED" | "SKIPPED" | "FAILED"
  reason             String? // canonical reason for SKIPPED/FAILED ("ACCOUNT_DISCONNECTED" | "NO_HOLDINGS" | "NOT_APPLICABLE" | "PROVIDER_FAILURE"); null for COVERED
  freshnessAdvanced  Boolean // did THIS execution freshly observe/write this account for this endpoint
  createdAt          DateTime         @default(now())

  @@index([refreshExecutionId]) // "coverage for this execution"
  @@index([financialAccountId, endpoint, createdAt]) // reverse: executions that covered account X for endpoint EP, newest first
  @@index([financialAccountId, createdAt]) // "which execution most recently refreshed this account"
}

// ─────────────────────────────────────────────────────────────────────────────
// ProviderCall  (DF-2D — provider-operation attribution)
//
// One row per ACTUAL external provider request ATTEMPT made during a refresh
// execution. Recorded at the ONE Plaid-client Proxy chokepoint (lib/plaid/
// client.ts) via an AsyncLocalStorage correlation context — no per-call-site
// instrumentation. Only calls that occur INSIDE a runFullRefresh context are
// attributed; provider calls outside a refresh (link-token, token exchange,
// item removal, webhook-key) write no ProviderCall (they belong to connection
// establishment / other flows, not a refresh).
//
// ATTRIBUTION, NOT BILLING: ApiUsageCounter remains the independent daily usage/
// billing authority (the Proxy still writes it); ProviderCall adds per-attempt
// execution attribution and correlates by (provider, operation). No dollar/
// billable units here — usage reconciliation is deferred.
//
// RETRIES + PAGINATION each produce a SEPARATE immutable row (attempt = the
// ordinal external request of this operation within the execution). A stage can
// SUCCEED after one or more FAILED provider attempts — ProviderCall.status is
// independent of RefreshEndpointResult.status.
//
// LINKAGE: FK to RefreshExecution (cascade — a provider call belongs to its
// execution, exactly like RefreshEndpointResult). The owning stage is stored as
// the `endpoint` STRING, NOT an FK to RefreshEndpointResult, because endpoint
// rows are persisted at execution CLOSE and do not exist during the call (and a
// call may occur between stages — null endpoint, never a forced association).
//
// DATA MINIMIZATION: allowlisted operational fields only. NEVER a token, secret,
// raw request/response payload, account number, or unbounded provider body. No
// free-form metadata dumping ground.
// ─────────────────────────────────────────────────────────────────────────────

model ProviderCall {
  id                 String           @id @default(cuid())
  refreshExecutionId String
  execution          RefreshExecution @relation(fields: [refreshExecutionId], references: [id], onDelete: Cascade)
  endpoint           String? // the stage active when the call fired ("TRANSACTIONS" | "BALANCES" | ...); null if between stages / shared prep
  provider           String // "PLAID" (free string — extensible vocabulary, matching ApiUsageCounter.provider)
  operation          String // provider method name, e.g. "transactionsSync" | "accountsGet" | "investmentsHoldingsGet" (matches ApiUsageCounter.metric)
  status             String // "SUCCEEDED" | "FAILED" | "RATE_LIMITED"
  attempt            Int              @default(1) // ordinal external request of this operation within the execution (retries + pagination)
  startedAt          DateTime
  completedAt        DateTime
  durationMs         Int // provider round-trip only — excludes local processing after the response
  providerRequestId  String? // Plaid request_id (support / incident lookup) when the SDK/response exposes it
  httpStatus         Int? // provider HTTP status when observable
  errorCode          String? // Plaid error_code (FAILED / RATE_LIMITED only) — reuses Plaid's own code, no new taxonomy
  errorCategory      String? // Plaid error_type (its own category, not a new local taxonomy)
  createdAt          DateTime         @default(now())

  @@index([refreshExecutionId]) // "provider calls for this execution"
  @@index([provider, operation]) // usage / failure by operation
  @@index([status, startedAt]) // failure / rate-limit scans
}

model RefreshEndpointResult {
  id                 String           @id @default(cuid())
  refreshExecutionId String
  execution          RefreshExecution @relation(fields: [refreshExecutionId], references: [id], onDelete: Cascade)
  endpoint           String // stage: "TRANSACTIONS" | "BALANCES" | "HOLDINGS" | "INVESTMENT_ACTIVITY" | "SNAPSHOT" | "RECONCILIATION" | legacy "HISTORY_BACKFILL" | V26-STAGE-1 "COVERAGE" | "RECONSTRUCTION" | "OWNERSHIP" | "PRICES" | "REGENERATION"
  stageKind          String // "PROVIDER" (a live provider endpoint) | "DERIVED" (a projection/derived stage) — disambiguates the mixed vocabulary
  /// "SUCCEEDED" | "FAILED" | "SKIPPED" | V26-STAGE-1 "PROVIDER_LIMITED".
  ///
  /// PROVIDER_LIMITED is neither success nor failure: the provider cannot serve
  /// the interval at all, so retrying changes nothing until capability moves.
  /// Folding it into FAILED would make every provider boundary read as an
  /// outage and invite endless retries; folding it into SUCCEEDED would claim
  /// evidence that was never returned.
  status             String
  skipReason         String? // "NOT_APPLICABLE" | "BUDGET" | "IN_FLIGHT" | "COOLDOWN" — set only when status = "SKIPPED"
  startedAt          DateTime
  completedAt        DateTime?
  durationMs         Int?
  recordsRead        Int?
  recordsWritten     Int?
  recordsChanged     Int?
  // DF-2B COVERAGE DOCTRINE: a COARSE evidence set of canonical FinancialAccount
  // ids DIRECTLY PROCESSED BY, or MATERIALLY USED AS INPUTS TO, this stage during
  // one execution. Point-in-time SOFT references (no FK to FinancialAccount), so a
  // later account deletion / merge / identity-correction never mutates execution
  // history. It is NOT a per-account freshness / success / completeness / outcome
  // authority: empty ≠ uncovered, present ≠ updated, present ≠ freshness-advanced.
  // Per-account current freshness lives on FinancialAccount.lastUpdated. Normalize
  // to a soft-ref child model only when per-account outcomes/reasons or reverse
  // account→execution queries become real consumers (first decision point: DF-2E).
  coveredAccountIds  String[]
  freshnessAdvanced  Boolean? // did this stage change canonical data (recordsChanged > 0)? — independent of coverage
  errorSummary       String?

  // ── V26-STAGE-1 — attributable, resumable historical stages ───────────────
  //
  // The connect/webhook historical layer was ONE opaque stage, so a failure
  // could not say which part failed, what had already landed, or where a retry
  // should resume — and a retry therefore re-paid provider calls for completed
  // work. These columns carry exactly what the retry and readiness authorities
  // (lib/plaid/historical-stages.core.ts) need, and nothing more.
  //
  // All nullable, no defaults: additive, zero migration risk. Every pre-existing
  // row — including legacy HISTORY_BACKFILL stages — reads null and stays
  // readable. Null means NOT RECORDED, never zero.

  /// 1-based attempt for this (execution, stage). Lets a stage be retried
  /// without destroying the evidence of the attempt that failed.
  attempt            Int?

  /// The historical interval this attempt actually covered. Resuming against a
  /// DIFFERENT window is not resumption — it would attribute settled work to a
  /// scope it never ran for — so the retry authority refuses it.
  windowFromISO      String?
  windowToISO        String?

  /// Which planner mode produced that window ("initial-full" | "incremental" |
  /// "fallback-full"), so a window can be explained without re-deriving it.
  plannerMode        String?

  /// Stable machine-readable failure code from STAGE_ERROR_CODES. Prose is
  /// never the stored authority; `errorSummary` above stays human-facing.
  errorCode          String?

  /// Whether a retry could plausibly change the outcome. A provider limit is
  /// settled-but-not-successful and is NOT retryable until capability changes.
  retryable          Boolean?

  /// Concise per-stage counts (planned/stored/considered/written/skipped…).
  /// Deliberately a SUMMARY: per-instrument detail already has owners
  /// (InvestmentEventCoverage, PositionReconstruction, SyncIssue), and copying
  /// it here would create a second, drifting authority.
  resultSummary      Json?

  createdAt          DateTime         @default(now())

  @@index([refreshExecutionId])
  @@index([endpoint, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// MerchantMergeDecision (MI2 S2 — Merchant Merge Review Queue)
// The durable record of a HUMAN verdict on one candidate merchant pair.
// Suggestions are NEVER persisted — the detector (lib/transactions/
// merchant-merge-suggest.ts) recomputes them on demand; only decisions are
// stored. The one thing not recomputable is a person's judgment: DISMISSED
// suppresses a pair from ever re-surfacing; MERGED is the evidence-tagged audit
// trail. One row per pair; a 3-way merge writes 2 rows sharing survivorKey.
//
// Keys are canonicalKey STRINGS, not FKs, because a merge DELETES the absorbed
// Merchant row — an FK would dangle. decidedByUserId is a soft ref (no FK
// relation), mirroring MerchantRule.ownerUserId, so this is a single additive
// block that touches no existing model. Execution stays in mergeMerchants();
// this table records the decision only.
// ─────────────────────────────────────────────────────────────────────────────

enum MerchantMergeVerdict {
  MERGED
  DISMISSED
}

model MerchantMergeDecision {
  id              String               @id @default(cuid())
  // Order-independent pair key: the two canonicalKeys sorted + joined. THE
  // dedupe/suppress key — makes "is this pair already decided?" an indexed
  // lookup and blocks duplicate decisions. A dismissal is symmetric.
  pairKey         String               @unique
  verdict         MerchantMergeVerdict
  // The surviving merchant's canonicalKey (meaningful for MERGED; for DISMISSED
  // it is simply one of the two, informational). Durable — the survivor persists.
  survivorKey     String
  // The absorbed merchant's canonicalKey — durable record of WHAT was merged
  // even after that Merchant row is deleted (no FK possible).
  absorbedKey     String
  // Evidence snapshot — WHY the decision was made. Regenerated evidence is
  // unavailable post-merge; this is the audit reason + future promotion signal.
  evidenceTier    String
  evidenceSignal  String?
  // The operator who decided. Soft ref (no FK), mirrors MerchantRule.ownerUserId;
  // survives user deletion without a cascade posture. Accountability only.
  decidedByUserId String?
  createdAt       DateTime             @default(now())

  @@index([verdict, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SnapshotAmendment (Wealth-timeline amendment system — Phase 2)
//
// One row per deliberate, consent-gated rebuild of an already-written historical
// range of SpaceSnapshot rows. Automatic A9 regen never rewrites a frozen
// (observed) row or a day whose account membership changed
// (regenerate-history.core.ts's frozen + skip-membership-changed guards); an
// amendment is the ONLY sanctioned way to revise such a day on purpose, in
// either direction (enrich the past with a newly-added long-held account, or
// erase a removed account's contribution). See the proposal doc §4.
//
// Phase 2 scope: PERSONAL-space flow only — PENDING → APPLIED, no approval
// state. Phase 3 (SHARED-space) will add PENDING_APPROVAL/APPROVED/DENIED +
// approver columns; deliberately not modelled yet.
// ─────────────────────────────────────────────────────────────────────────────

enum SnapshotAmendmentKind {
  ACCOUNT_ADDED_RETROACTIVE // enrich past days with a newly-added long-held account
  ACCOUNT_REMOVED_RETROACTIVE // erase a removed account's contribution from past days
  ACCOUNT_HARD_DELETED // like REMOVED, but the account is being permanently deleted
  IMPORT_ENRICHMENT // enrich past days from newly-imported historical data
}

enum SnapshotAmendmentStatus {
  PENDING // created, not yet applied
  APPLIED // the affected SpaceSnapshot rows have been rewritten in place
}

model SnapshotAmendment {
  id                 String                  @id @default(cuid())
  spaceId            String
  space              Space                   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  // Soft ref (no FK), mirroring MerchantMergeDecision.decidedByUserId. An FK with
  // onDelete: Cascade would DESTROY this amendment — and, via
  // SnapshotAmendmentDay's cascade, its whole stored per-day breakdown — the
  // moment the account is hard-deleted. That directly contradicts this table's
  // purpose (a stored delta must stay true even AFTER the account is
  // hard-deleted; ACCOUNT_HARD_DELETED is a first-class kind). So the account is
  // referenced by id only. spaceId / requestedByUserId keep their FKs: nothing
  // promises an amendment outlives its own space or requester, only its account.
  financialAccountId String
  kind               SnapshotAmendmentKind
  fromDate           DateTime                @db.Date
  toDate             DateTime                @db.Date
  requestedByUserId  String
  requestedByUser    User                    @relation("SnapshotAmendmentRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  requestedAt        DateTime                @default(now())
  status             SnapshotAmendmentStatus @default(PENDING)
  // The explicit "yes, rewrite my history" confirmation — an auditable fact, not
  // a boolean anyone could flip. Set when the amendment is applied.
  consentedAt        DateTime?
  appliedAt          DateTime?
  // Links to the AuditLog row written on apply (same auditLogId-link pattern the
  // sync-complete flow uses), so Activity gets a quantified delta for free.
  auditLogId         String?
  // Per-day stored before/after breakdown — NOT recompute-on-read: a stored value
  // stays true forever even after the account is hard-deleted and its source
  // transactions are gone. See proposal §4.
  days               SnapshotAmendmentDay[]
  // The SpaceSnapshot rows most recently revised by this amendment.
  amendedSnapshots   SpaceSnapshot[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([spaceId, status])
  @@index([financialAccountId])
  @@index([requestedByUserId])
}

model SnapshotAmendmentDay {
  id             String            @id @default(cuid())
  amendmentId    String
  amendment      SnapshotAmendment @relation(fields: [amendmentId], references: [id], onDelete: Cascade)
  date           DateTime          @db.Date
  // before/after for each component that changed (null = unchanged / no prior row).
  stocksBefore   Float?
  stocksAfter    Float?
  cryptoBefore   Float?
  cryptoAfter    Float?
  cashBefore     Float?
  cashAfter      Float?
  savingsBefore  Float?
  savingsAfter   Float?
  debtBefore     Float?
  debtAfter      Float?
  netWorthBefore Float?
  netWorthAfter  Float?

  @@unique([amendmentId, date])
  @@index([amendmentId])
}
